<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  AddServiceCategoryDialog.fxml — Dialog thêm loại dịch vụ mới
  Controller: PetHotel.gui.controller.AddServiceCategoryController
  
  Dành cho vai trò: Quản lý chi nhánh (BRANCH_MANAGER)
-->

<VBox spacing="16" styleClass="dialog-content" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PetHotel.gui.controller.AddServiceCategoryController">

    <!-- Tiêu đề dialog -->
    <Label styleClass="dialog-title" text="Thêm Loại Dịch Vụ Mới" />

    <!-- Form nhập liệu -->
    <VBox spacing="12">

        <!-- Tên loại dịch vụ -->
        <VBox spacing="4">
            <Label styleClass="form-label" text="Tên Loại Dịch Vụ *" />
            <TextField fx:id="txtCategoryName" maxWidth="Infinity" promptText="Nhập tên loại dịch vụ (vd: Tắm chó, Cắt lông...)" styleClass="form-input" />
            <Label fx:id="lblCategoryNameError" styleClass="error-message" text="" />
        </VBox>

        <!-- Ghi chú -->
        <VBox spacing="4">
            <Label styleClass="form-label" text="Ghi Chú (Tùy Chọn)" />
            <TextArea fx:id="txtNote" maxWidth="Infinity" prefRowCount="4" promptText="Nhập ghi chú/mô tả về loại dịch vụ này..." styleClass="form-textarea" wrapText="true" />
            <Label fx:id="lblNoteError" styleClass="error-message" text="" />
        </VBox>

    </VBox>

    <!-- Nút thao tác -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" styleClass="action-btn action-btn-outline" text="Hủy" />
        <Button onAction="#handleSave" styleClass="action-btn action-btn-primary" text="Thêm Loại Dịch Vụ" />
    </HBox>

    <Label styleClass="info-text" text="Thông tin được đánh dấu (*) là bắt buộc." />

</VBox>
