<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" styleClass="main-content" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PetHotel.gui.controller.CustomerController">

    <fx:define>
        <ToggleGroup fx:id="customerPetTabs" />
    </fx:define>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Region styleClass="section-header-line" />
        <VBox spacing="2">
            <Label fx:id="titleLabel" styleClass="section-header" text="Quản Lý Khách Hàng" />
            <Label fx:id="subtitleLabel" styleClass="ph-page-subtitle" text="Quản lý thông tin khách hàng" />
        </VBox>
        <HBox alignment="CENTER_LEFT" spacing="6" styleClass="ph-module-tabs">
            <ToggleButton fx:id="tabCustomer" onAction="#onShowCustomerTab" selected="true" styleClass="ph-module-tab" text="Quản lý khách hàng">
            <toggleGroup>
               <ToggleGroup fx:id="customerPetTabs" />
            </toggleGroup></ToggleButton>
            <ToggleButton fx:id="tabPet" onAction="#onShowPetTab" styleClass="ph-module-tab" text="Danh sách thú cưng" toggleGroup="$customerPetTabs" />
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnAddCustomer" onAction="#onAddCustomer" styleClass="action-btn action-btn-primary" text="Thêm Khách Hàng" />
    </HBox>

    <StackPane fx:id="tabContent" VBox.vgrow="ALWAYS">
        <VBox fx:id="customerTabPane" spacing="18" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-box" HBox.hgrow="ALWAYS">
                    <Label styleClass="search-icon" text="" />
                    <TextField fx:id="searchField" onAction="#onSearch" promptText="Tìm theo mã KH, tên, SĐT, 3 số cuối SĐT, CCCD..." styleClass="search-input" HBox.hgrow="ALWAYS" />
                </HBox>
                <Button onAction="#onSearch" style="-fx-padding: 7 16 7 16;" styleClass="action-btn action-btn-primary" text="Tìm" />
                <Button onAction="#onClearFilter" style="-fx-padding: 7 14 7 14;" styleClass="action-btn action-btn-outline" text="Xóa lọc" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="action-toolbar">
                <Button fx:id="btnEdit" disable="true" onAction="#onEdit" styleClass="action-btn action-btn-outline" text="Sửa" />
                <Button fx:id="btnHistory" disable="true" onAction="#onViewHistory" styleClass="action-btn action-btn-outline" text="Lịch Sử DV" />
            </HBox>

            <VBox spacing="12" styleClass="content-panel" VBox.vgrow="ALWAYS">
                <TableView fx:id="customerTable" onMouseClicked="#onTableClick" VBox.vgrow="ALWAYS">
                    <styleClass>
                        <String fx:value="data-table" />
                        <String fx:value="management-table" />
                        <String fx:value="ph-pet-table" />
                        <String fx:value="ph-customer-table" />
                    </styleClass>
                    <columns>
                        <TableColumn fx:id="colId" minWidth="110" prefWidth="120" text="Mã KH" />
                        <TableColumn fx:id="colName" minWidth="220" prefWidth="260" text="Họ Tên" />
                        <TableColumn fx:id="colPhone" minWidth="140" prefWidth="160" text="SĐT" />
                        <TableColumn fx:id="colEmail" minWidth="240" prefWidth="300" text="Email" />
                        <TableColumn fx:id="colPetCount" minWidth="90" prefWidth="100" text="Thú Cưng" />
                        <TableColumn fx:id="colJoined" minWidth="140" prefWidth="160" text="Ngày Tham Gia" />
                    </columns>
                    <placeholder>
                        <Label styleClass="table-empty" text="Chưa có khách hàng nào" />
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Label fx:id="customerPageInfo" styleClass="ph-page-info" text="Hiển thị 0 / 0 khách hàng" />
                    <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="1" />
                </HBox>
            </VBox>
        </VBox>
    </StackPane>

</VBox>
