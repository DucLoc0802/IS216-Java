<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" styleClass="main-content" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.InventoryController">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Region styleClass="section-header-line" />
        <VBox spacing="2">
            <Label styleClass="section-header" text="Quản Lý Tồn Kho" />
            <Label styleClass="ph-page-subtitle" text="Xem tồn kho sản phẩm/vật tư tiêu hao theo chi nhánh" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="totalLabel" styleClass="ph-page-info" text="Hiển thị 0 dòng tồn kho" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Chi nhánh" />
            <ComboBox fx:id="branchCombo" onAction="#onSearch" prefWidth="155" styleClass="filter-combo" />
        </VBox>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-box" HBox.hgrow="ALWAYS">
            <Label styleClass="search-icon" text="" />
            <TextField fx:id="searchField"
                       onAction="#onSearch"
                       promptText="Tìm sản phẩm..."
                       styleClass="search-input"
                       HBox.hgrow="ALWAYS" />
        </HBox>
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Trạng thái tồn" />
            <ComboBox fx:id="stockStatusCombo" onAction="#onSearch" prefWidth="160" styleClass="filter-combo" />
        </VBox>
        <Button minWidth="72"
                onAction="#onSearch"
                styleClass="action-btn action-btn-primary"
                text="Tìm" />
        <Button minWidth="92"
                onAction="#onClearFilter"
                styleClass="action-btn action-btn-outline"
                text="Xóa lọc" />
    </HBox>

    <VBox fx:id="lowStockAlertPanel" spacing="10" styleClass="inventory-alert-panel">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="lowStockAlertIcon" minHeight="30" minWidth="30" styleClass="inventory-alert-icon" text="OK" />
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="lowStockSummaryLabel" styleClass="inventory-alert-title" text="Đang tải cảnh báo tồn kho..." />
                <Label fx:id="lowStockDetailLabel" styleClass="inventory-alert-detail" text="Kiểm tra các sản phẩm dưới điểm đặt hàng lại" wrapText="true" />
            </VBox>
            <Button fx:id="btnShowOutStock"
                    managed="false"
                    onAction="#onShowOutStock"
                    styleClass="action-btn action-btn-outline inventory-alert-action"
                    text="Hết hàng"
                    visible="false" />
            <Button fx:id="btnShowLowStock"
                    managed="false"
                    onAction="#onShowLowStock"
                    styleClass="action-btn action-btn-outline inventory-alert-action"
                    text="Sắp hết"
                    visible="false" />
        </HBox>
        <HBox fx:id="lowStockItemsBox" alignment="CENTER_LEFT" managed="false" spacing="10" visible="false" />
    </VBox>

    <VBox spacing="12" styleClass="content-panel" VBox.vgrow="ALWAYS">
        <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
            <styleClass>
                <String fx:value="data-table" />
                <String fx:value="management-table" />
            </styleClass>
            <columns>
                <TableColumn fx:id="colProductId" minWidth="110" prefWidth="125" text="Mã sản phẩm" />
                <TableColumn fx:id="colProductName" minWidth="220" prefWidth="270" text="Tên sản phẩm" />
                <TableColumn fx:id="colCategoryName" minWidth="155" prefWidth="185" text="Loại sản phẩm" />
                <TableColumn fx:id="colUnit" minWidth="85" prefWidth="100" text="Đơn vị" />
                <TableColumn fx:id="colQuantity" minWidth="115" prefWidth="135" text="Số lượng tồn" />
                <TableColumn fx:id="colReorderPoint" minWidth="140" prefWidth="165" text="Điểm đặt hàng lại" />
                <TableColumn fx:id="colStockStatus" minWidth="130" prefWidth="155" text="Trạng thái tồn" />
                <TableColumn fx:id="colLastUpdated" minWidth="170" prefWidth="200" text="Cập nhật lần cuối" />
                <TableColumn fx:id="colActions" minWidth="125" prefWidth="135" text="Thao tác" />
            </columns>
            <placeholder>
                <Label styleClass="table-empty" text="Không có dữ liệu tồn kho" />
            </placeholder>
        </TableView>
    </VBox>

</VBox>
