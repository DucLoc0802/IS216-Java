<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="520" prefWidth="520" spacing="0"
      styleClass="form-root"
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.ProductCategoryDialogController">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
        <Label styleClass="form-header-icon" text="" />
        <VBox spacing="2">
            <Label styleClass="form-header-title" text="Thêm Loại Sản Phẩm" />
            <Label styleClass="form-header-subtitle" text="Tạo nhóm phân loại cho vật tư tiêu hao" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" styleClass="form-close-btn" text="Đóng" />
    </HBox>

    <VBox spacing="16" styleClass="form-body">
        <Label styleClass="form-section-title" text="Thông Tin Loại Sản Phẩm" />
        <VBox spacing="4">
            <Label styleClass="form-label" text="Tên Loại Sản Phẩm *" />
            <TextField fx:id="categoryNameField"
                       promptText="VD: Vệ sinh, Cắt tỉa, Nhuộm..."
                       styleClass="form-field" />
            <Label fx:id="categoryNameErrorLabel" styleClass="form-error" text="" />
        </VBox>
        <Label styleClass="form-hint" text="Loại sản phẩm mới sẽ xuất hiện trong bộ lọc và form sản phẩm" />
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="form-footer">
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" styleClass="btn-secondary" text="Hủy" />
        <Button onAction="#handleSave" styleClass="btn-primary" text="Thêm Loại" />
    </HBox>
</VBox>
