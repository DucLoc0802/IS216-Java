<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- invoice-management.fxml | Controller: InvoiceController -->

<VBox spacing="18" styleClass="main-content" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PetHotel.gui.controller.InvoiceController">

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Region styleClass="section-header-line" />
        <Label styleClass="section-header" text="Quản Lý Hóa Đơn" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onCreateInvoice" styleClass="action-btn action-btn-primary" text="+ Tạo Hóa Đơn" />
        <Button fx:id="btnPay" disable="true" onAction="#onPayment" styleClass="action-btn action-btn-success" text="💳 Thanh Toán" />
        <Button fx:id="btnCancelInvoice" disable="true" onAction="#onCancelInvoice" style="-fx-text-fill: #b91c1c; -fx-border-color: #b91c1c;" styleClass="action-btn action-btn-outline" text="Hủy hóa đơn" />
        <Button fx:id="btnPrint" disable="true" onAction="#onPrint" styleClass="action-btn action-btn-outline" text="🖨 In / Xuất" />
        <Button fx:id="btnPaymentHistory" onAction="#onPaymentHistory" styleClass="action-btn action-btn-outline" text="Lịch sử giao dịch" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-box" HBox.hgrow="ALWAYS">
            <Label styleClass="search-icon" text="🔍" />
            <TextField fx:id="txtSearch" promptText="Mã HĐ, tên khách hàng..." styleClass="search-input" HBox.hgrow="ALWAYS" />
        </HBox>
        <DatePicker fx:id="filterFrom" prefWidth="140" styleClass="filter-combo" />
        <DatePicker fx:id="filterTo" prefWidth="140" styleClass="filter-combo" />
        <ComboBox fx:id="cbbStatusFilter" prefWidth="130" promptText="Trạng thái" styleClass="filter-combo" />
        <Button onAction="#handleSearch" style="-fx-padding: 7 16 7 16;" styleClass="action-btn action-btn-primary" text="Lọc" />
    </HBox>

    <HBox spacing="18">
        <VBox spacing="12" styleClass="content-panel" HBox.hgrow="ALWAYS">
            <TableView fx:id="tableInvoice" styleClass="data-table invoice-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colOrderId" prefWidth="110" text="Mã HĐ" />
                    <TableColumn fx:id="colCustomer" prefWidth="170" text="Khách Hàng" />
                    <TableColumn fx:id="colCreatedDate" prefWidth="180" text="Ngày Tạo" />
                    <TableColumn fx:id="colGrandTotal" prefWidth="150" text="Tổng Tiền" />
                    <TableColumn fx:id="colStatus" prefWidth="150" text="Trạng Thái" />
                </columns>
                <placeholder>
                    <Label styleClass="table-empty" text="Không có hóa đơn nào" />
                </placeholder>
            </TableView>
            
            <HBox alignment="CENTER_RIGHT">
                <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="1" />
            </HBox>
        </VBox>

    </HBox>

</VBox>
