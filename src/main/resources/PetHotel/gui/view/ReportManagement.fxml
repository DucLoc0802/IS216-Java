<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" styleClass="main-content" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.ReportController">

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Region styleClass="section-header-line" />
        <VBox spacing="2">
            <Label styleClass="section-header" text="Báo Cáo &amp; Thống Kê" />
            <Label text="Doanh thu, booking, công suất phòng, kho và toàn chuỗi"
                   style="-fx-font-size: 11px; -fx-text-fill: -ph-text-muted;" />
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
        <Label text="Loại thống kê:" styleClass="filter-label" />
        <ComboBox fx:id="cbbReportType" prefWidth="140" styleClass="filter-combo" />
        <Label text="Từ ngày:" styleClass="filter-label" />
        <DatePicker fx:id="dpFromDate" prefWidth="140" styleClass="filter-combo" />
        <Label text="Đến ngày:" styleClass="filter-label" />
        <DatePicker fx:id="dpToDate" prefWidth="140" styleClass="filter-combo" />
        <Button onAction="#onFilterReport" styleClass="action-btn action-btn-primary" text="Lọc" />
        <Button onAction="#onResetReport" styleClass="action-btn action-btn-outline" text="Tháng hiện tại" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onExportReport" styleClass="action-btn action-btn-amber" text="Xuất file" />
    </HBox>

    <HBox spacing="14">
        <VBox styleClass="stat-card stat-card-amber" HBox.hgrow="ALWAYS">
            <Label fx:id="lblSummaryTitle1" text="Chỉ số 1" styleClass="stat-label" />
            <Label fx:id="lblSummaryValue1" text="—" styleClass="stat-value" />
            <Label fx:id="lblSummaryNote1" text="Theo báo cáo đang chọn" styleClass="stat-sublabel" />
        </VBox>
        <VBox styleClass="stat-card stat-card-green" HBox.hgrow="ALWAYS">
            <Label fx:id="lblSummaryTitle2" text="Chỉ số 2" styleClass="stat-label" />
            <Label fx:id="lblSummaryValue2" text="—" styleClass="stat-value" />
            <Label fx:id="lblSummaryNote2" text="Theo báo cáo đang chọn" styleClass="stat-sublabel" />
        </VBox>
        <VBox styleClass="stat-card stat-card-brown" HBox.hgrow="ALWAYS">
            <Label fx:id="lblSummaryTitle3" text="Chỉ số 3" styleClass="stat-label" />
            <Label fx:id="lblSummaryValue3" text="—" styleClass="stat-value" />
            <Label fx:id="lblSummaryNote3" text="Theo báo cáo đang chọn" styleClass="stat-sublabel" />
        </VBox>
        <VBox styleClass="stat-card stat-card-red" HBox.hgrow="ALWAYS">
            <Label fx:id="lblSummaryTitle4" text="Chỉ số 4" styleClass="stat-label" />
            <Label fx:id="lblSummaryValue4" text="—" styleClass="stat-value" />
            <Label fx:id="lblSummaryNote4" text="Theo báo cáo đang chọn" styleClass="stat-sublabel" />
        </VBox>
    </HBox>

    <TabPane fx:id="tabPaneReport" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab fx:id="tabRevenue" text="Doanh thu">
                <VBox spacing="12" styleClass="content-panel">
                    <TableView fx:id="tableRevenue" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colRevenuePeriod" prefWidth="170" text="Thời gian" />
                            <TableColumn fx:id="colRevenueInvoiceCount" prefWidth="120" text="Số hóa đơn" />
                            <TableColumn fx:id="colRevenueTotal" prefWidth="170" text="Tổng doanh thu" />
                            <TableColumn fx:id="colRevenuePaid" prefWidth="170" text="Đã thanh toán" />
                            <TableColumn fx:id="colRevenueRemaining" prefWidth="170" text="Còn lại" />
                        </columns>
                        <placeholder><Label text="Chưa có dữ liệu doanh thu" /></placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <Tab fx:id="tabBooking" text="Booking">
                <VBox spacing="12" styleClass="content-panel">
                    <TableView fx:id="tableBooking" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colBookingPeriod" prefWidth="170" text="Thời gian" />
                            <TableColumn fx:id="colBookingCount" prefWidth="130" text="Số booking" />
                            <TableColumn fx:id="colBookingNew" prefWidth="140" text="Booking mới" />
                            <TableColumn fx:id="colBookingCompleted" prefWidth="160" text="Hoàn thành" />
                            <TableColumn fx:id="colBookingCancelled" prefWidth="140" text="Đã hủy" />
                        </columns>
                        <placeholder><Label text="Chưa có dữ liệu booking" /></placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <Tab fx:id="tabRoomUsage" text="Công suất phòng">
                <VBox spacing="12" styleClass="content-panel">
                    <TableView fx:id="tableRoomUsage" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colRoomPeriod" prefWidth="170" text="Thời gian" />
                            <TableColumn fx:id="colRoomTotal" prefWidth="130" text="Tổng phòng" />
                            <TableColumn fx:id="colRoomInUse" prefWidth="150" text="Đang sử dụng" />
                            <TableColumn fx:id="colRoomAvailable" prefWidth="130" text="Còn trống" />
                            <TableColumn fx:id="colRoomUsageRate" prefWidth="150" text="Tỷ lệ sử dụng (%)" />
                        </columns>
                        <placeholder><Label text="Chưa có dữ liệu phòng" /></placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <Tab fx:id="tabInventory" text="Kho">
                <VBox spacing="12" styleClass="content-panel">
                    <TableView fx:id="tableInventory" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colInventoryScope" prefWidth="220" text="Chi nhánh" />
                            <TableColumn fx:id="colInventorySku" prefWidth="130" text="Tổng SKU" />
                            <TableColumn fx:id="colInventoryStock" prefWidth="140" text="Tổng tồn kho" />
                            <TableColumn fx:id="colInventoryLow" prefWidth="150" text="Tồn thấp" />
                            <TableColumn fx:id="colInventoryOut" prefWidth="150" text="Hết hàng" />
                        </columns>
                        <placeholder><Label text="Chưa có dữ liệu kho" /></placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <Tab fx:id="tabChain" text="Toàn chuỗi">
                <VBox spacing="12" styleClass="content-panel">
                    <TableView fx:id="tableChain" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colChainBranchId" prefWidth="120" text="Mã chi nhánh" />
                            <TableColumn fx:id="colChainBranchName" prefWidth="220" text="Tên chi nhánh" />
                            <TableColumn fx:id="colChainRevenue" prefWidth="170" text="Tổng doanh thu" />
                            <TableColumn fx:id="colChainBooking" prefWidth="140" text="Số booking" />
                            <TableColumn fx:id="colChainRoomInUse" prefWidth="160" text="Phòng đang dùng" />
                        </columns>
                        <placeholder><Label text="Chưa có dữ liệu toàn chuỗi" /></placeholder>
                    </TableView>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
