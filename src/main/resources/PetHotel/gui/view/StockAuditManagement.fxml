<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" styleClass="main-content" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.StockAuditController">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Region styleClass="section-header-line" />
        <VBox spacing="2">
            <Label styleClass="section-header" text="Kiểm Kê Kho" />
            <Label styleClass="ph-page-subtitle" text="Tạo, sửa và hoàn tất phiếu kiểm kê tồn kho" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="totalLabel" styleClass="ph-page-info" text="Hiển thị 0 phiếu kiểm kê" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Chi nhánh" />
            <ComboBox fx:id="branchCombo" onAction="#onSearch" prefWidth="155" styleClass="filter-combo" />
        </VBox>
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Trạng thái" />
            <ComboBox fx:id="statusFilter" onAction="#onSearch" prefWidth="145" styleClass="filter-combo" />
        </VBox>
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Từ ngày" />
            <DatePicker fx:id="fromDatePicker" onAction="#onSearch" prefWidth="145" styleClass="filter-combo" />
        </VBox>
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Đến ngày" />
            <DatePicker fx:id="toDatePicker" onAction="#onSearch" prefWidth="145" styleClass="filter-combo" />
        </VBox>
        <Button minWidth="72" onAction="#onSearch" styleClass="action-btn action-btn-primary" text="Tìm" />
        <Button minWidth="92" onAction="#onClearFilter" styleClass="action-btn action-btn-outline" text="Xóa lọc" />
    </HBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="content-panel" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="action-toolbar">
                <Button minWidth="155" onAction="#onCreateAudit" styleClass="action-btn action-btn-primary" text="Tạo Phiếu Kiểm Kê" />
                <Button fx:id="btnEditAudit" disable="true" minWidth="92" onAction="#onEditAudit" styleClass="action-btn action-btn-outline" text="Sửa phiếu" />
                <Button fx:id="btnCompleteAudit" disable="true" minWidth="135" onAction="#onCompleteAudit" styleClass="action-btn action-btn-primary" text="Hoàn tất kiểm kê" />
                <Button fx:id="btnCancelAudit" disable="true" minWidth="92" onAction="#onCancelAudit" styleClass="action-btn action-btn-danger" text="Hủy phiếu" />
            </HBox>

            <TableView fx:id="auditTable" VBox.vgrow="ALWAYS">
                <styleClass>
                    <String fx:value="data-table" />
                    <String fx:value="management-table" />
                </styleClass>
                <columns>
                    <TableColumn fx:id="colAuditId" minWidth="100" prefWidth="115" text="Mã kiểm kê" />
                    <TableColumn fx:id="colAuditBranchId" minWidth="85" prefWidth="100" text="Chi nhánh" />
                    <TableColumn fx:id="colAuditEmployeeName" minWidth="145" prefWidth="175" text="Nhân viên lập" />
                    <TableColumn fx:id="colAuditDate" minWidth="115" prefWidth="135" text="Ngày kiểm kê" />
                    <TableColumn fx:id="colAuditStatus" minWidth="110" prefWidth="130" text="Trạng thái" />
                    <TableColumn fx:id="colAuditNote" minWidth="150" prefWidth="185" text="Ghi chú" />
                    <TableColumn fx:id="colAuditActions" minWidth="270" prefWidth="280" resizable="false" text="Thao tác" />
                </columns>
                <placeholder>
                    <Label styleClass="table-empty" text="Không có phiếu kiểm kê" />
                </placeholder>
            </TableView>
        </VBox>

        <VBox minWidth="500" prefWidth="540" spacing="12" styleClass="content-panel">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Region styleClass="section-header-line" />
                <Label fx:id="formTitle" styleClass="panel-title" text="Tạo phiếu kiểm kê" />
            </HBox>

            <HBox spacing="10">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Chi nhánh" />
                    <ComboBox fx:id="auditBranchCombo" prefWidth="170" styleClass="form-combo" />
                </VBox>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Ghi chú" />
                    <TextArea fx:id="auditNoteArea" prefRowCount="2" promptText="Ghi chú kiểm kê..." styleClass="form-area" wrapText="true" />
                </VBox>
            </HBox>

            <TableView fx:id="auditDetailTable" editable="true" VBox.vgrow="ALWAYS">
                <styleClass>
                    <String fx:value="data-table" />
                    <String fx:value="management-table" />
                </styleClass>
                <columns>
                    <TableColumn fx:id="colDetailProductId" minWidth="85" prefWidth="95" text="Mã SP" />
                    <TableColumn fx:id="colDetailProductName" minWidth="145" prefWidth="170" text="Tên sản phẩm" />
                    <TableColumn fx:id="colDetailUnit" minWidth="70" prefWidth="80" text="Đơn vị" />
                    <TableColumn fx:id="colSystemQuantity" minWidth="110" prefWidth="125" text="SL hệ thống" />
                    <TableColumn fx:id="colActualQuantity" minWidth="105" prefWidth="125" text="SL thực tế" />
                    <TableColumn fx:id="colDifferenceQuantity" minWidth="105" prefWidth="125" text="Chênh lệch" />
                    <TableColumn fx:id="colDifferenceRate" minWidth="90" prefWidth="105" text="Tỷ lệ" />
                    <TableColumn fx:id="colDetailNote" minWidth="130" prefWidth="155" text="Ghi chú" />
                </columns>
                <placeholder>
                    <Label styleClass="table-empty" text="Chọn phiếu DRAFT để nhập số lượng thực tế" />
                </placeholder>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="8">
                <Button minWidth="92" onAction="#onSaveDraft" styleClass="action-btn action-btn-outline" text="Lưu nháp" />
                <Button minWidth="105" onAction="#onCreateAudit" styleClass="action-btn action-btn-primary" text="Tạo phiếu" />
                <Button minWidth="92" onAction="#onCompleteAudit" styleClass="action-btn action-btn-primary" text="Hoàn tất" />
            </HBox>
        </VBox>
    </HBox>

</VBox>
