<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="main-content" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PetHotel.gui.controller.StockAuditController">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Region styleClass="section-header-line" />
            <VBox spacing="2">
                <Label styleClass="section-header" text="Kiểm Kê Kho" />
                <Label style="-fx-font-size:11px; -fx-text-fill: -ph-text-muted;" text="Tạo, sửa và hoàn tất phiếu kiểm kê tồn kho" />
            </VBox>
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="totalLabel" style="-fx-font-size:11px; -fx-text-fill: -ph-text-muted;" text="Hiển thị 0 phiếu kiểm kê" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Chi nhánh" />
            <ComboBox fx:id="branchCombo" onAction="#onSearch" prefWidth="145" styleClass="filter-combo" />
        </VBox>
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Trạng thái" />
            <ComboBox fx:id="statusFilter" onAction="#onSearch" prefWidth="135" styleClass="filter-combo" />
        </VBox>
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Từ ngày" />
            <DatePicker fx:id="fromDatePicker" onAction="#onSearch" prefWidth="135" styleClass="filter-combo" />
        </VBox>
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Đến ngày" />
            <DatePicker fx:id="toDatePicker" onAction="#onSearch" prefWidth="135" styleClass="filter-combo" />
        </VBox>
        <Button onAction="#onSearch" styleClass="action-btn action-btn-primary" text="Tìm" />
        <Button onAction="#onClearFilter" styleClass="action-btn action-btn-outline" text="Xóa lọc" />
    </HBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="content-panel" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="action-toolbar">
                <Button onAction="#onCreateAudit" styleClass="action-btn action-btn-primary" text="Tạo Phiếu Kiểm Kê" />
                <Button fx:id="btnEditAudit" disable="true" onAction="#onEditAudit" styleClass="action-btn action-btn-outline" text="Sửa phiếu" />
                <Button fx:id="btnCompleteAudit" disable="true" onAction="#onCompleteAudit" styleClass="action-btn action-btn-primary" text="Hoàn tất kiểm kê" />
                <Button fx:id="btnCancelAudit" disable="true" onAction="#onCancelAudit" styleClass="action-btn action-btn-danger" text="Hủy phiếu" />
            </HBox>

            <TableView fx:id="auditTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colAuditId" prefWidth="95" text="Mã kiểm kê" />
                    <TableColumn fx:id="colAuditBranchId" prefWidth="90" text="Chi nhánh" />
                    <TableColumn fx:id="colAuditEmployeeName" prefWidth="140" text="Nhân viên lập" />
                    <TableColumn fx:id="colAuditDate" prefWidth="95" text="Ngày kiểm kê" />
                    <TableColumn fx:id="colAuditStatus" prefWidth="105" text="Trạng thái" />
                    <TableColumn fx:id="colAuditNote" prefWidth="150" text="Ghi chú" />
                    <TableColumn fx:id="colAuditActions" prefWidth="190" text="Thao tác" />
                </columns>
                <placeholder>
                    <Label styleClass="table-empty" text="Không có phiếu kiểm kê" />
                </placeholder>
            </TableView>
        </VBox>

        <VBox minWidth="430" prefWidth="480" spacing="12" styleClass="content-panel">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Region styleClass="section-header-line" />
                <Label fx:id="formTitle" styleClass="panel-title" text="Tạo phiếu kiểm kê" />
            </HBox>

            <HBox spacing="10">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Chi nhánh" />
                    <ComboBox fx:id="auditBranchCombo" prefWidth="160" styleClass="form-combo" />
                </VBox>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Ghi chú" />
                    <TextArea fx:id="auditNoteArea" prefRowCount="2" promptText="Ghi chú kiểm kê..." styleClass="form-area" wrapText="true" />
                </VBox>
            </HBox>

            <TableView fx:id="auditDetailTable" editable="true" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDetailProductId" prefWidth="85" text="Mã SP" />
                    <TableColumn fx:id="colDetailProductName" prefWidth="135" text="Tên sản phẩm" />
                    <TableColumn fx:id="colDetailUnit" prefWidth="65" text="Đơn vị" />
                    <TableColumn fx:id="colSystemQuantity" prefWidth="105" text="SL hệ thống" />
                    <TableColumn fx:id="colActualQuantity" prefWidth="105" text="SL thực tế" />
                    <TableColumn fx:id="colDifferenceQuantity" prefWidth="105" text="Chênh lệch" />
                    <TableColumn fx:id="colDifferenceRate" prefWidth="105" text="Tỷ lệ" />
                    <TableColumn fx:id="colDetailNote" prefWidth="135" text="Ghi chú" />
                </columns>
                <placeholder>
                    <Label styleClass="table-empty" text="Chọn phiếu DRAFT để nhập số lượng thực tế" />
                </placeholder>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="8">
                <Button onAction="#onSaveDraft" styleClass="action-btn action-btn-outline" text="Lưu nháp" />
                <Button onAction="#onCreateAudit" styleClass="action-btn action-btn-primary" text="Tạo phiếu" />
                <Button onAction="#onCompleteAudit" styleClass="action-btn action-btn-primary" text="Hoàn tất" />
            </HBox>
        </VBox>
    </HBox>

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>
</VBox>
