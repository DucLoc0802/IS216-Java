<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="dialog-content" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.CreateBookingController"
      prefWidth="600" prefHeight="500">

    <Label styleClass="dialog-title" text="Tạo Booking Mới" />

    <GridPane hgap="12" vgap="12">
        <Label text="Khách Hàng *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cbCustomer" prefWidth="300"
                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Thú Cưng *" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="cbPet" prefWidth="300"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Loại Phòng" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="cbRoomType" prefWidth="300"
                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Phòng *" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="cbRoom" prefWidth="300"
                  GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Ngày Check-in *" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <DatePicker fx:id="dateCheckin" prefWidth="300"
                    GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Ngày Check-out *" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <DatePicker fx:id="dateCheckout" prefWidth="300"
                    GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label text="Đặt Cọc" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <TextField fx:id="txtDeposit" promptText="0"
                   GridPane.columnIndex="1" GridPane.rowIndex="6"/>

        <Label text="Ghi Chú" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <TextArea fx:id="txtNote" prefHeight="60" prefWidth="300"
                  GridPane.columnIndex="1" GridPane.rowIndex="7"/>
    </GridPane>

    <Label fx:id="lblError" style="-fx-text-fill: red;" text=""/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnCancel" onAction="#onCancel" text="Hủy"
                styleClass="action-btn action-btn-outline"/>
        <Button onAction="#onSave" text="Lưu"
                styleClass="action-btn action-btn-primary"/>
    </HBox>

</VBox>