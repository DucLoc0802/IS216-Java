<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="560" prefWidth="560" spacing="0"
      styleClass="form-root"
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.MaterialWasteController">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
        <Label styleClass="form-header-icon" text="" />
        <VBox spacing="2">
            <Label styleClass="form-header-title" text="Ghi Nhận Hao Hụt Vật Liệu" />
            <Label fx:id="lblContext" styleClass="form-header-subtitle" text="Lập phiếu hao hụt vật liệu và chờ quản lý duyệt" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" styleClass="form-close-btn" text="Đóng" />
    </HBox>

    <VBox spacing="16" styleClass="form-body">
        <Label styleClass="form-section-title" text="Vật Liệu Hao Hụt" />

        <VBox spacing="4">
            <Label styleClass="form-label" text="Vật Liệu *" />
            <ComboBox fx:id="cmbProduct" styleClass="form-combo" promptText="Chọn vật liệu hao hụt" />
            <Label fx:id="lblProductError" styleClass="form-error" text="" />
        </VBox>

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Tồn Khả Dụng" />
                <Label fx:id="lblAvailableQty" styleClass="detail-value" text="—" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Số Lượng Hao Hụt *" />
                <TextField fx:id="txtQuantity" styleClass="form-field" promptText="VD: 50" />
                <Label fx:id="lblQuantityError" styleClass="form-error" text="" />
            </VBox>
        </HBox>

        <Separator styleClass="form-divider" />
        <Label styleClass="form-section-title" text="Lý Do" />

        <VBox spacing="4">
            <Label styleClass="form-label" text="Lý Do Hao Hụt *" />
            <ComboBox fx:id="cmbReason" styleClass="form-combo" promptText="Chọn hoặc nhập lý do" />
            <Label fx:id="lblReasonError" styleClass="form-error" text="" />
        </VBox>

        <VBox spacing="4">
            <Label styleClass="form-label" text="Ghi Chú" />
            <TextArea fx:id="txtNote" prefRowCount="3" wrapText="true" styleClass="form-area"
                      promptText="VD: Dùng vượt định mức do lông dày, đổ/rơi vãi khi thao tác..." />
        </VBox>

        <Label fx:id="lblGeneralError" styleClass="form-error" text="" />
        <Label styleClass="form-hint" text="Sau khi lưu, phiếu ở trạng thái chờ duyệt. Tồn kho chỉ trừ khi quản lý duyệt phiếu." />
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="form-footer">
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" styleClass="btn-secondary" text="Hủy" />
        <Button onAction="#handleSave" styleClass="btn-primary" text="Lập Phiếu" />
    </HBox>
</VBox>
