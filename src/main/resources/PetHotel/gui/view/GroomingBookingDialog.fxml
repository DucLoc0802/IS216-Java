<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="550" prefWidth="550" spacing="0" 
      styleClass="form-root"
      stylesheets="@../css/style.css" 
      xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="PetHotel.gui.controller.GroomingBookingController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
        <Label styleClass="form-header-icon" text="" />
        <VBox spacing="2">
            <Label fx:id="formTitle" 
                   styleClass="form-header-title"
                   text="Đặt Lịch Grooming" />
            <Label fx:id="formSubtitle" 
                   styleClass="form-header-subtitle"
                   text="Chọn dịch vụ và nhân viên thực hiện" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" 
                styleClass="form-close-btn"
                text="Đóng" />
    </HBox>

    <!-- BODY -->
    <VBox spacing="16" styleClass="form-body">

        <!-- SECTION: Thông Tin Khách Hàng -->
        <Label styleClass="form-section-title" text="Thông Tin Khách Hàng &amp; Thú Cưng" />

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Khách hàng *" />
                <ComboBox fx:id="cbCustomer" styleClass="form-combo" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Thú cưng *" />
                <ComboBox fx:id="cbPet" styleClass="form-combo" />
            </VBox>
        </HBox>

        <Separator styleClass="form-divider" />

        <!-- SECTION: Dịch Vụ -->
        <Label styleClass="form-section-title" text="Dịch Vụ Grooming" />

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Loại dịch vụ *" />
                <ComboBox fx:id="cbServiceCategory" styleClass="form-combo" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Dịch vụ grooming *" />
                <ComboBox fx:id="cbService" styleClass="form-combo" />
            </VBox>
        </HBox>

        <Separator styleClass="form-divider" />

        <!-- SECTION: Lịch Hẹn -->
        <Label styleClass="form-section-title" text="Lịch Hẹn &amp; Nhân Viên" />

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Ngày hẹn *" />
                <DatePicker fx:id="dpScheduleDate" styleClass="form-combo" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Giờ hẹn *" />
                <TextField fx:id="txtScheduleTime"
                          promptText="VD: 09:30" 
                          styleClass="form-field" />
            </VBox>
        </HBox>

        <VBox spacing="4">
            <Label styleClass="form-label" text="Nhân viên *" />
            <ComboBox fx:id="cbEmployee" styleClass="form-combo" />
        </VBox>

        <Separator styleClass="form-divider" />

        <!-- SECTION: Ghi Chú -->
        <Label styleClass="form-section-title" text="Ghi Chú" />

        <VBox spacing="4">
            <Label styleClass="form-label" text="Ghi chú bổ sung" />
            <TextArea fx:id="txtNote" 
                     promptText="Ví dụ: sợ tắm, cắn nhẹ, có dị ứng..." 
                     styleClass="form-area"
                     prefRowCount="3"
                     wrapText="true" />
            <Label styleClass="form-hint" text="Không bắt buộc - dùng để ghi nhận đặc điểm đặc biệt" />
        </VBox>

    </VBox>

    <!-- FOOTER -->
    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="form-footer">
        <Button onAction="#handleCancel" 
                styleClass="btn-secondary" 
                text="Hủy" />
        <Button onAction="#handleSave" 
                styleClass="btn-primary" 
                text="Lưu Lịch" />
    </HBox>

</VBox>