<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="PetHotel.gui.controller.GroomingBookingController"
      spacing="16"
      prefWidth="620"
      style="-fx-background-color: #fffaf5;">

    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <Label text="Đặt Lịch Grooming"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #3b2314;"/>

    <GridPane hgap="14" vgap="14">
        <columnConstraints>
            <ColumnConstraints prefWidth="160"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Khách hàng:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbCustomer" prefWidth="360"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Thú cưng:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbPet" prefWidth="360"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Loại dịch vụ:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbServiceCategory" prefWidth="360"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Dịch vụ grooming:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbService" prefWidth="360"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Nhân viên:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbEmployee" prefWidth="360"
                  GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Ngày hẹn:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpScheduleDate" prefWidth="360"
                    GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Giờ hẹn:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="txtScheduleTime"
                   promptText="Ví dụ: 09:30"
                   GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Ghi chú:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextArea fx:id="txtNote"
                  prefRowCount="3"
                  wrapText="true"
                  GridPane.rowIndex="7"
                  GridPane.columnIndex="1"/>
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Hủy" onAction="#handleCancel"/>
        <Button text="Lưu lịch"
                onAction="#handleSave"
                style="-fx-background-color: #5b2f1b; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

</VBox>