<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" styleClass="main-content" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.ServiceController">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Region styleClass="section-header-line" />
        <VBox spacing="2">
            <Label styleClass="section-header" text="Quản Lý Dịch Vụ" />
            <Label styleClass="ph-page-subtitle" text="Xem, tìm kiếm và quản lý danh sách dịch vụ" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnMaterialStandard"
                minWidth="132"
                onAction="#onOpenMaterialStandard"
                styleClass="action-btn action-btn-outline"
                text="Vật Tư Tiêu Hao" />
        <Button fx:id="btnAddCategory"
                minWidth="150"
                onAction="#handleAddCategory"
                styleClass="action-btn action-btn-outline"
                text="Thêm Loại Dịch Vụ"
                visible="false" />
        <Button fx:id="btnAddService"
                minWidth="145"
                onAction="#handleAddService"
                styleClass="action-btn action-btn-primary"
                text="Thêm Dịch Vụ"
                visible="false" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-box" HBox.hgrow="ALWAYS">
            <Label styleClass="search-icon" text="" />
            <TextField fx:id="searchField"
                       onAction="#handleSearch"
                       promptText="Tìm theo tên dịch vụ, loài hoặc loại dịch vụ..."
                       styleClass="search-input"
                       HBox.hgrow="ALWAYS" />
        </HBox>
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Loại dịch vụ" />
            <ComboBox fx:id="filterCategory" prefWidth="230" styleClass="filter-combo" />
        </VBox>
        <Button minWidth="72"
                onAction="#handleSearch"
                styleClass="action-btn action-btn-primary"
                text="Tìm" />
        <Button minWidth="92"
                onAction="#handleClearFilter"
                styleClass="action-btn action-btn-outline"
                text="Xóa lọc" />
    </HBox>

    <VBox spacing="12" styleClass="content-panel" VBox.vgrow="ALWAYS">
        <TableView fx:id="serviceTable" onMouseClicked="#handleTableClick" VBox.vgrow="ALWAYS">
            <styleClass>
                <String fx:value="data-table" />
                <String fx:value="management-table" />
            </styleClass>
            <columns>
                <TableColumn fx:id="colServiceId" minWidth="95" prefWidth="110" text="Mã DV" />
                <TableColumn fx:id="colServiceName" minWidth="220" prefWidth="260" text="Tên Dịch Vụ" />
                <TableColumn fx:id="colCategory" minWidth="160" prefWidth="190" text="Loại Dịch Vụ" />
                <TableColumn fx:id="colSpecies" minWidth="90" prefWidth="110" text="Loài" />
                <TableColumn fx:id="colPrice" minWidth="125" prefWidth="145" text="Giá (VNĐ)" />
                <TableColumn fx:id="colDuration" minWidth="130" prefWidth="150" text="Thời gian" />
                <TableColumn fx:id="colStatus" minWidth="150" prefWidth="175" text="Trạng Thái" />
            </columns>
            <placeholder>
                <Label styleClass="table-empty" text="Chưa có dịch vụ nào hoặc không tìm thấy kết quả" />
            </placeholder>
        </TableView>
    </VBox>

</VBox>
