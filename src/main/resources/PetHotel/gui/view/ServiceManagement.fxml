<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  ServiceManagement.fxml — Quản Lý / Xem Danh Sách Dịch Vụ
  Controller: PetHotel.gui.controller.ServiceController
  
  Dành cho vai trò: Quản lý chi nhánh, Lễ tân
  
  Chức năng:
   - Xem danh sách tất cả dịch vụ đang hoạt động
   - Tìm kiếm dịch vụ theo tên, loài hoặc loại dịch vụ
   - Lọc dịch vụ theo loại (category)
   - Xem chi tiết dịch vụ (giá, thời gian, loài, ...)
-->

<VBox spacing="18" styleClass="main-content" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PetHotel.gui.controller.ServiceController">

    <!-- Tiêu đề màn hình -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Region styleClass="section-header-line" />
        <Label styleClass="section-header" text="Xem Danh Sách Dịch Vụ" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnAddService" onAction="#handleAddService" styleClass="action-btn action-btn-primary" text="Thêm Dịch Vụ Mới" visible="false" />
        <Button fx:id="btnAddCategory" onAction="#handleAddCategory" styleClass="action-btn action-btn-primary" text="Thêm Loại Dịch Vụ" visible="false" />
    </HBox>

    <!-- Thanh tìm kiếm -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-box" HBox.hgrow="ALWAYS">
            <Label styleClass="search-icon" text="" />
            <TextField fx:id="searchField" onAction="#handleSearch" promptText="Tìm theo tên dịch vụ, loài, hoặc loại..." styleClass="search-input" HBox.hgrow="ALWAYS" />
        </HBox>
        <Button onAction="#handleSearch" style="-fx-padding: 7 16 7 16;" styleClass="action-btn action-btn-primary" text="Tìm" />
        <Button onAction="#handleClearFilter" style="-fx-padding: 7 14 7 14;" styleClass="action-btn action-btn-outline" text="Xóa lọc" />
    </HBox>

    <!-- Bộ lọc theo loại dịch vụ (Category) -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
        <Label styleClass="filter-label" text="Lọc theo loại dịch vụ:" />
        <ComboBox fx:id="filterCategory" prefWidth="250" styleClass="filter-combo" />
    </HBox>

    <!-- Bảng danh sách dịch vụ -->
    <VBox spacing="12" styleClass="content-panel" VBox.vgrow="ALWAYS">
        <TableView fx:id="serviceTable" onMouseClicked="#handleTableClick" styleClass="data-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colServiceId" prefWidth="100" text="Mã DV" />
                <TableColumn fx:id="colServiceName" prefWidth="200" text="Tên Dịch Vụ" />
                <TableColumn fx:id="colCategory" prefWidth="150" text="Loại Dịch Vụ" />
                <TableColumn fx:id="colSpecies" prefWidth="100" text="Loài" />
                <TableColumn fx:id="colPrice" prefWidth="120" text="Giá (VNĐ)" />
                <TableColumn fx:id="colDuration" prefWidth="100" text="Thời gian (phút)" />
                <TableColumn fx:id="colStatus" prefWidth="120" text="Trạng Thái" />
            </columns>
            <placeholder>
                <Label styleClass="table-empty" text="Chưa có dịch vụ nào hoặc không tìm thấy kết quả" />
            </placeholder>
        </TableView>
    </VBox>

    <Label styleClass="info-text" text="💡 Ghi chú: Nhấp đôi vào một dịch vụ để xem chi tiết" />

</VBox>
