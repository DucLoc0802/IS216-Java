<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" maxWidth="520" prefWidth="520"
      styleClass="form-root"
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.EmployeeFormController">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
        <Label styleClass="form-header-icon" text="" />
        <VBox spacing="2">
            <Label styleClass="form-header-title" text="Thông Tin Nhân Viên" />
            <Label styleClass="form-header-subtitle" text="Thêm mới hoặc cập nhật hồ sơ nhân viên" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onCancel" styleClass="form-close-btn" text="Đóng" />
    </HBox>

    <VBox spacing="14" styleClass="form-body">
        <VBox spacing="4">
            <Label text="Mã nhân viên" styleClass="form-label" />
            <TextField fx:id="txtEmployeeId" promptText="Tự động sinh khi thêm mới" styleClass="form-field" />
        </VBox>

        <VBox spacing="4">
            <Label text="Họ và tên" styleClass="form-label" />
            <TextField fx:id="txtFullName" styleClass="form-field" />
        </VBox>

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Email" styleClass="form-label" />
                <TextField fx:id="txtEmail" styleClass="form-field" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Số điện thoại" styleClass="form-label" />
                <TextField fx:id="txtPhone" styleClass="form-field" />
            </VBox>
        </HBox>

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Chi nhánh" styleClass="form-label" />
                <ComboBox fx:id="cbBranch" styleClass="filter-combo" prefWidth="220" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Trạng thái" styleClass="form-label" />
                <ComboBox fx:id="cbStatus" styleClass="filter-combo" prefWidth="220" />
            </VBox>
        </HBox>

        <VBox spacing="4">
            <Label text="Ghi chú" styleClass="form-label" />
            <TextArea fx:id="txtNote" prefRowCount="4" wrapText="true" styleClass="form-area" />
        </VBox>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="form-footer">
        <Button onAction="#onCancel" styleClass="action-btn action-btn-outline" text="Hủy" />
        <Button fx:id="btnSave" onAction="#onSave" styleClass="action-btn action-btn-primary" text="Lưu" />
    </HBox>
</VBox>
