<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" maxWidth="460" prefWidth="460"
      styleClass="form-root"
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.ChangePasswordController">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
        <Label styleClass="form-header-icon" text="🔑" />
        <VBox spacing="2">
            <Label styleClass="form-header-title" text="Đổi Mật Khẩu" />
            <Label styleClass="form-header-subtitle" text="Cập nhật mật khẩu đăng nhập của bạn" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onCancel" styleClass="form-close-btn" text="✕" />
    </HBox>

    <VBox spacing="14" styleClass="form-body">
        <VBox spacing="4">
            <Label text="Mật khẩu hiện tại" styleClass="form-label" />
            <PasswordField fx:id="txtOldPassword" styleClass="form-field" />
        </VBox>

        <VBox spacing="4">
            <Label text="Mật khẩu mới" styleClass="form-label" />
            <PasswordField fx:id="txtNewPassword" styleClass="form-field" />
        </VBox>

        <VBox spacing="4">
            <Label text="Xác nhận mật khẩu mới" styleClass="form-label" />
            <PasswordField fx:id="txtConfirmPassword" styleClass="form-field" />
        </VBox>

        <Label fx:id="lblHint" styleClass="form-hint" text="" wrapText="true" />
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="form-footer">
        <Button onAction="#onCancel" styleClass="action-btn action-btn-outline" text="Hủy" />
        <Button fx:id="btnSave" onAction="#onSave" styleClass="action-btn action-btn-primary" text="Đổi mật khẩu" />
    </HBox>
</VBox>
