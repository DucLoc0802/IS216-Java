<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" styleClass="main-content" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.PaymentHistoryController">

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Region styleClass="section-header-line" />
        <Label styleClass="section-header" text="Lịch Sử Giao Dịch" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
        <TextField fx:id="txtSearch" promptText="Mã hóa đơn hoặc mã thanh toán" styleClass="search-input" HBox.hgrow="ALWAYS" />
        <VBox spacing="4">
            <Label styleClass="form-label" text="Phương thức thanh toán" />
            <ComboBox fx:id="cbbMethod" prefWidth="170" styleClass="filter-combo" />
        </VBox>
        <VBox spacing="4">
            <Label styleClass="form-label" text="Trạng thái" />
            <ComboBox fx:id="cbbStatus" prefWidth="130" styleClass="filter-combo" />
        </VBox>
        <DatePicker fx:id="dpFromDate" prefWidth="140" promptText="Từ ngày" styleClass="filter-combo" />
        <DatePicker fx:id="dpToDate" prefWidth="140" promptText="Đến ngày" styleClass="filter-combo" />
        <Button onAction="#onSearch" styleClass="action-btn action-btn-primary" text="Tìm kiếm" />
        <Button onAction="#onClear" styleClass="action-btn action-btn-outline" text="Xóa bộ lọc" />
    </HBox>

    <VBox spacing="12" styleClass="content-panel" VBox.vgrow="ALWAYS">
        <TableView fx:id="tablePayment" styleClass="data-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPaymentId" prefWidth="120" text="Mã thanh toán" />
                <TableColumn fx:id="colOrderId" prefWidth="110" text="Mã hóa đơn" />
                <TableColumn fx:id="colCustomer" prefWidth="180" text="Khách hàng" />
                <TableColumn fx:id="colMethod" prefWidth="140" text="Phương thức" />
                <TableColumn fx:id="colAmount" prefWidth="120" text="Số tiền" />
                <TableColumn fx:id="colStatus" prefWidth="110" text="Trạng thái" />
                <TableColumn fx:id="colPaidAt" prefWidth="170" text="Ngày thanh toán" />
            </columns>
        </TableView>
    </VBox>
</VBox>
