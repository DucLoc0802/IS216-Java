<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="520" prefWidth="520" spacing="0" 
      styleClass="form-root"
      stylesheets="@../css/style.css, @../css/styles.css" 
      xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="PetHotel.gui.controller.CustomerFormController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
        <Label styleClass="form-header-icon" text="" />
        <VBox spacing="2">
            <Label fx:id="formTitle" 
                   styleClass="form-header-title"
                   text="Tạo Khách Hàng Mới" />
            <Label fx:id="formSubtitle" 
                   styleClass="form-header-subtitle"
                   text="Điền đầy đủ thông tin khách hàng bên dưới" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onCancel" 
                styleClass="form-close-btn"
                text="Đóng" />
    </HBox>

    <!-- BODY -->
    <VBox spacing="16" styleClass="form-body">

        <!-- SECTION: Thông Tin Cơ Bản -->
        <Label styleClass="form-section-title" text="Thông Tin Cơ Bản" />

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Họ và tên *" />
                <TextField fx:id="txtFullName" 
                          promptText="Nguyễn Văn A" 
                          styleClass="form-field" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Số điện thoại *" />
                <TextField fx:id="txtPhone" 
                          promptText="0901234567" 
                          styleClass="form-field" />
            </VBox>
        </HBox>

        <VBox spacing="4">
            <Label styleClass="form-label" text="Email *" />
            <TextField fx:id="txtEmail" 
                      promptText="khachhang@example.com" 
                      styleClass="form-field" />
            <Label styleClass="form-hint" 
                   text="Email sẽ dùng để gửi thông báo đặt phòng và hóa đơn" />
        </VBox>

        <Separator styleClass="form-divider" />

        <!-- SECTION: Địa Chỉ -->
        <Label styleClass="form-section-title" text="Địa Chỉ &amp; Ghi Chú" />

        <VBox spacing="4">
            <Label styleClass="form-label" text="Địa chỉ" />
            <TextArea fx:id="txtAddress" 
                     promptText="123 Đường ABC, Quận 1, TP.HCM" 
                     styleClass="form-area"
                     prefRowCount="3"
                     wrapText="true" />
            <Label styleClass="form-hint" text="Không bắt buộc - dùng cho giao hàng hoặc liên hệ" />
        </VBox>

        <Separator styleClass="form-divider" />

        <!-- SECTION: Điểm Thưởng -->
        <Label styleClass="form-section-title" text="Điểm Tích Lũy" />

        <HBox spacing="14" alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Điểm hiện tại" />
                <TextField fx:id="txtLoyaltyPoints" 
                          text="0" 
                          editable="false"
                          styleClass="form-field, form-field-readonly" />
            </VBox>
            <Label styleClass="form-hint"
                   text="(Tự động tích lũy qua hóa đơn)" />
        </HBox>

        <!-- ERROR LABEL -->
        <Label fx:id="lblError" 
               styleClass="form-error"
               text="" 
               wrapText="true" 
               visible="false" />
    </VBox>

    <!-- FOOTER -->
    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="form-footer">
        <Button onAction="#onCancel" 
                styleClass="btn-secondary" 
                text="Hủy" />
        <Button fx:id="btnSubmit" 
                onAction="#onSubmit" 
                styleClass="btn-primary" 
                text="Tạo Khách Hàng" />
    </HBox>

</VBox>