<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" styleClass="main-content" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.GoodsReceiptController">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Region styleClass="section-header-line" />
        <VBox spacing="2">
            <Label styleClass="section-header" text="Nhập Kho" />
            <Label styleClass="ph-page-subtitle" text="Lập, sửa, duyệt và hủy phiếu nhập kho" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="totalLabel" styleClass="ph-page-info" text="Hiển thị 0 phiếu nhập" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-box" HBox.hgrow="ALWAYS">
            <Label styleClass="search-icon" text="" />
            <TextField fx:id="searchField"
                       onAction="#onSearch"
                       promptText="Tìm mã phiếu / nhà cung cấp..."
                       styleClass="search-input"
                       HBox.hgrow="ALWAYS" />
        </HBox>
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Trạng thái" />
            <ComboBox fx:id="statusFilter" onAction="#onSearch" prefWidth="145" styleClass="filter-combo" />
        </VBox>
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Từ ngày" />
            <DatePicker fx:id="fromDatePicker" onAction="#onSearch" prefWidth="145" styleClass="filter-combo" />
        </VBox>
        <VBox spacing="3">
            <Label styleClass="filter-label" text="Đến ngày" />
            <DatePicker fx:id="toDatePicker" onAction="#onSearch" prefWidth="145" styleClass="filter-combo" />
        </VBox>
        <Button minWidth="72" onAction="#onSearch" styleClass="action-btn action-btn-primary" text="Tìm" />
        <Button minWidth="92" onAction="#onClearFilter" styleClass="action-btn action-btn-outline" text="Xóa lọc" />
    </HBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="content-panel" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="action-toolbar">
                <Button minWidth="135" onAction="#onNewReceipt" styleClass="action-btn action-btn-primary" text="Lập Phiếu Nhập" />
                <Button fx:id="btnEditReceipt" disable="true" minWidth="92" onAction="#onEditReceipt" styleClass="action-btn action-btn-outline" text="Sửa phiếu" />
                <Button fx:id="btnApproveReceipt" disable="true" minWidth="100" onAction="#onApproveReceipt" styleClass="action-btn action-btn-primary" text="Duyệt phiếu" />
                <Button fx:id="btnCancelReceipt" disable="true" minWidth="92" onAction="#onCancelReceipt" styleClass="action-btn action-btn-danger" text="Hủy phiếu" />
            </HBox>

            <TableView fx:id="receiptTable" VBox.vgrow="ALWAYS">
                <styleClass>
                    <String fx:value="data-table" />
                    <String fx:value="management-table" />
                </styleClass>
                <columns>
                    <TableColumn fx:id="colReceiptId" minWidth="90" prefWidth="105" text="Mã phiếu" />
                    <TableColumn fx:id="colBranchId" minWidth="85" prefWidth="100" text="Chi nhánh" />
                    <TableColumn fx:id="colEmployeeName" minWidth="145" prefWidth="170" text="Nhân viên lập" />
                    <TableColumn fx:id="colSupplierName" minWidth="145" prefWidth="175" text="Nhà cung cấp" />
                    <TableColumn fx:id="colReceiptDate" minWidth="105" prefWidth="120" text="Ngày nhập" />
                    <TableColumn fx:id="colTotalQuantity" minWidth="110" prefWidth="135" text="Tổng số lượng" />
                    <TableColumn fx:id="colTotalItemCount" minWidth="115" prefWidth="140" text="Tổng mặt hàng" />
                    <TableColumn fx:id="colStatus" minWidth="105" prefWidth="125" text="Trạng thái" />
                    <TableColumn fx:id="colActions" minWidth="250" prefWidth="260" resizable="false" text="Thao tác" />
                </columns>
                <placeholder>
                    <Label styleClass="table-empty" text="Không có phiếu nhập" />
                </placeholder>
            </TableView>
        </VBox>

        <VBox minWidth="450" prefWidth="480" spacing="12" styleClass="content-panel">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Region styleClass="section-header-line" />
                <Label fx:id="formTitle" styleClass="panel-title" text="Lập phiếu nhập" />
            </HBox>

            <HBox spacing="10">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Chi nhánh" />
                    <ComboBox fx:id="branchCombo" prefWidth="160" styleClass="form-combo" />
                </VBox>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Ngày nhập" />
                    <DatePicker fx:id="receiptDatePicker" prefWidth="170" styleClass="form-combo" />
                </VBox>
            </HBox>

            <VBox spacing="3">
                <Label styleClass="form-label" text="Nhà cung cấp" />
                <TextField fx:id="supplierField" promptText="Nhập nhà cung cấp..." styleClass="form-field" />
            </VBox>

            <VBox spacing="3">
                <Label styleClass="form-label" text="Ghi chú" />
                <TextArea fx:id="receiptNoteArea" prefRowCount="2" promptText="Ghi chú phiếu nhập..." styleClass="form-area" wrapText="true" />
            </VBox>

            <HBox spacing="8">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Sản phẩm" />
                    <ComboBox fx:id="productCombo" prefWidth="210" styleClass="form-combo" />
                </VBox>
                <VBox spacing="3">
                    <Label styleClass="form-label" text="Số lượng" />
                    <TextField fx:id="quantityField" prefWidth="95" promptText="0" styleClass="form-field" />
                </VBox>
                <VBox spacing="3">
                    <Label styleClass="form-label" text="Đơn vị" />
                    <ComboBox fx:id="unitField" prefWidth="85" styleClass="form-combo" />
                </VBox>
            </HBox>

            <HBox spacing="8">
                <VBox spacing="3">
                    <Label styleClass="form-label" text="Thành tiền" />
                    <TextField fx:id="lineTotalField" prefWidth="125" promptText="Tự tính nếu rỗng" styleClass="form-field" />
                </VBox>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Ghi chú dòng" />
                    <TextField fx:id="detailNoteField" promptText="Ghi chú..." styleClass="form-field" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="8">
                <Button minWidth="155" onAction="#onAddDetailLine" styleClass="action-btn action-btn-outline" text="Thêm dòng sản phẩm" />
                <Button minWidth="92" onAction="#onRemoveDetailLine" styleClass="action-btn action-btn-danger" text="Xóa dòng" />
            </HBox>

            <TableView fx:id="detailTable" prefHeight="180">
                <styleClass>
                    <String fx:value="data-table" />
                    <String fx:value="management-table" />
                </styleClass>
                <columns>
                    <TableColumn fx:id="colDetailProduct" minWidth="160" prefWidth="180" text="Sản phẩm" />
                    <TableColumn fx:id="colDetailQuantity" minWidth="80" prefWidth="90" text="Số lượng" />
                    <TableColumn fx:id="colDetailUnit" minWidth="70" prefWidth="80" text="Đơn vị" />
                    <TableColumn fx:id="colDetailLineTotal" minWidth="105" prefWidth="120" text="Thành tiền" />
                    <TableColumn fx:id="colDetailNote" minWidth="120" prefWidth="140" text="Ghi chú" />
                </columns>
                <placeholder>
                    <Label styleClass="table-empty" text="Chưa có dòng sản phẩm" />
                </placeholder>
            </TableView>

            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <Button minWidth="92" onAction="#onSaveDraft" styleClass="action-btn action-btn-outline" text="Lưu nháp" />
                <Button minWidth="105" onAction="#onSaveAndApprove" styleClass="action-btn action-btn-primary" text="Duyệt phiếu" />
            </HBox>
        </VBox>
    </HBox>

</VBox>
