<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="PetHotel.gui.controller.GroomingStaffAssignmentController"
      spacing="16"
      stylesheets="@../css/style.css"
      style="-fx-padding: 20 24 24 24; -fx-background-color: -ph-bg-main;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Phân Công Nhân Viên Thực Hiện Grooming"
               styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnRefresh"
                text="Làm mới"
                styleClass="action-btn action-btn-outline"/>
    </HBox>

    <!-- Filter Bar -->
    <HBox spacing="12" styleClass="filter-bar">
        <Label text="Lọc theo:" styleClass="filter-label"/>
        <DatePicker fx:id="dpFilterDate" prefWidth="150" styleClass="filter-combo"/>
        <ComboBox fx:id="cbFilterStatus" prefWidth="150" promptText="Trạng thái" styleClass="filter-combo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="txtSearch" prefWidth="200" promptText="Tìm kiếm theo tên pet, khách hàng..." styleClass="filter-field"/>
    </HBox>

    <!-- Main Content -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        
        <!-- Unassigned Tasks List -->
        <VBox spacing="12" styleClass="content-panel" HBox.hgrow="ALWAYS">
            <Label text="Danh Sách Công Việc Chưa Phân Công"
                   styleClass="panel-title"/>
            
            <TableView fx:id="taskTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTaskId" prefWidth="70" text="Mã Công Việc"/>
                    <TableColumn fx:id="colScheduleTime" prefWidth="90" text="Giờ Hẹn"/>
                    <TableColumn fx:id="colPetName" prefWidth="100" text="Thú Cưng"/>
                    <TableColumn fx:id="colCustomerName" prefWidth="120" text="Khách Hàng"/>
                    <TableColumn fx:id="colServiceName" prefWidth="120" text="Dịch Vụ"/>
                    <TableColumn fx:id="colStatus" prefWidth="100" text="Trạng Thái"/>
                </columns>
                <placeholder>
                    <Label text="Không có công việc chưa phân công" styleClass="table-empty"/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Assignment Panel -->
        <VBox spacing="14" styleClass="content-panel" prefWidth="340">
            <Label text="Phân Công"
                   styleClass="panel-title"/>
            
            <Separator styleClass="form-divider"/>
            
            <!-- Selected Task Info -->
            <VBox spacing="8">
                <Label text="Công Việc Được Chọn:" styleClass="form-label"/>
                <VBox style="-fx-background-color: -ph-bg-input; -fx-background-radius: 6px; -fx-border-color: -ph-border-input; -fx-border-radius: 6px; -fx-border-width: 1px; -fx-padding: 10px;" spacing="6">
                    <HBox spacing="8">
                        <Label text="Mã công việc:" style="-fx-font-size: 11px; -fx-text-fill: -ph-text-secondary;"/>
                        <Label fx:id="lblSelectedTaskId" text="—" style="-fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Thú cưng:" style="-fx-font-size: 11px; -fx-text-fill: -ph-text-secondary;"/>
                        <Label fx:id="lblSelectedPetName" text="—" style="-fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Dịch vụ:" style="-fx-font-size: 11px; -fx-text-fill: -ph-text-secondary;"/>
                        <Label fx:id="lblSelectedService" text="—" style="-fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Giờ hẹn:" style="-fx-font-size: 11px; -fx-text-fill: -ph-text-secondary;"/>
                        <Label fx:id="lblSelectedTime" text="—" style="-fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Staff Selection -->
            <VBox spacing="8">
                <Label text="Chọn Nhân Viên:" styleClass="form-label"/>
                <ComboBox fx:id="cbStaff" styleClass="form-combo" promptText="Chọn nhân viên..."/>
                <VBox fx:id="staffAvailabilityBox" spacing="6">
                    <Label text="Tình trạng nhân viên:" styleClass="form-hint"/>
                    <HBox spacing="6">
                        <Region prefWidth="10"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <HBox spacing="6">
                                <Label text="Công việc hôm nay:" style="-fx-font-size: 11px;"/>
                                <Label fx:id="lblTodayTasks" text="0" style="-fx-font-weight: bold; -fx-text-fill: -ph-blue;"/>
                            </HBox>
                            <HBox spacing="6">
                                <Label text="Trạng thái:" style="-fx-font-size: 11px;"/>
                                <Label fx:id="lblStaffStatus" text="Có sẵn" style="-fx-font-weight: bold; -fx-text-fill: -ph-green;"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>

            <Separator styleClass="form-divider"/>

            <!-- Assignment Note -->
            <VBox spacing="8">
                <Label text="Ghi Chú:" styleClass="form-label"/>
                <TextArea fx:id="txtAssignmentNote"
                          styleClass="form-area"
                          prefRowCount="3"
                          wrapText="true"
                          promptText="Ghi chú về công việc này..."/>
            </VBox>

            <!-- Action Buttons -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="btnAssign"
                        text="Phân Công"
                        styleClass="btn-primary"/>
                <Button fx:id="btnClear"
                        text="Xóa"
                        styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </HBox>

</VBox>
