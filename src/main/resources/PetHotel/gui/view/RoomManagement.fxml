<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  room-management.fxml — Quản Lý Phòng
  Controller: PetHotel.gui.controller.RoomController
-->

<VBox spacing="18" styleClass="main-content" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PetHotel.gui.controller.RoomController">

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Region styleClass="section-header-line" />
        <Label styleClass="section-header" text="Quản Lý Phòng" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onAddRoom" styleClass="action-btn action-btn-primary" text="+ Thêm Phòng" />
        <Button onAction="#onRoomTypes" styleClass="action-btn action-btn-outline" text="📋 Loại Phòng &amp; Giá" />
    </HBox>

    <HBox spacing="14">
        <VBox styleClass="stat-card stat-card-red" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="stat-icon" text="🏠" />
                <VBox spacing="2">
                    <Label styleClass="stat-label" text="Đang Sử Dụng" />
                    <Label fx:id="countOccupied" styleClass="stat-value" text="—" />
                </VBox>
            </HBox>
        </VBox>
        <VBox styleClass="stat-card stat-card-green" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="stat-icon" text="✅" />
                <VBox spacing="2">
                    <Label styleClass="stat-label" text="Phòng Trống" />
                    <Label fx:id="countAvailable" styleClass="stat-value" text="—" />
                </VBox>
            </HBox>
        </VBox>
        <VBox styleClass="stat-card stat-card-amber" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="stat-icon" text="🧹" />
                <VBox spacing="2">
                    <Label styleClass="stat-label" text="Đang Dọn" />
                    <Label fx:id="countCleaning" styleClass="stat-value" text="—" />
                </VBox>
            </HBox>
        </VBox>
        <VBox styleClass="stat-card stat-card-purple" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="stat-icon" text="🚧" />
                <VBox spacing="2">
                    <Label styleClass="stat-label" text="Bảo Trì" />
                    <Label fx:id="countMaintenance" styleClass="stat-value" text="—" />
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
        <HBox alignment="CENTER_LEFT" prefWidth="240" spacing="8" styleClass="search-box">
            <Label styleClass="search-icon" text="🔍" />
            <TextField fx:id="searchField" onAction="#onSearch" promptText="Mã phòng, loại phòng..." styleClass="search-input" />
        </HBox>
        <ComboBox fx:id="filterStatus" prefWidth="140" promptText="Trạng thái" styleClass="filter-combo" />
        <ComboBox fx:id="filterType" prefWidth="140" promptText="Loại phòng" styleClass="filter-combo" />
        <Button onAction="#onFilter" style="-fx-padding: 7 16 7 16;" styleClass="action-btn action-btn-primary" text="Lọc" />
    </HBox>

    <VBox spacing="12" styleClass="content-panel" VBox.vgrow="ALWAYS">
        <TableView fx:id="roomTable" styleClass="data-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colRoomId" prefWidth="90" text="Mã Phòng" />
                <TableColumn fx:id="colRoomNumber" prefWidth="90" text="Số Phòng" />
                <TableColumn fx:id="colRoomType" prefWidth="130" text="Loại" />
                <TableColumn fx:id="colRoomFloor" prefWidth="70" text="Tầng" />
                <TableColumn fx:id="colRoomPrice" prefWidth="110" text="Giá/Ngày" />
                <TableColumn fx:id="colRoomCap" prefWidth="90" text="Sức Chứa" />
                <TableColumn fx:id="colRoomStatus" prefWidth="110" text="Trạng Thái" />
                <TableColumn fx:id="colRoomPet" prefWidth="150" text="Thú Cưng Hiện Tại" />
                <TableColumn fx:id="colRoomAction" prefWidth="120" resizable="false" text="Thao Tác" />
            </columns>
            <placeholder>
                <Label styleClass="table-empty" text="Không có phòng nào" />
            </placeholder>
        </TableView>
        
        <HBox alignment="CENTER_RIGHT">
            <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="1" />
        </HBox>
    </VBox>

</VBox>
