<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="550" prefWidth="550" spacing="0" 
      styleClass="form-root"
      stylesheets="@../css/style.css" 
      xmlns="http://javafx.com/javafx/25" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="PetHotel.gui.controller.ServiceDetailController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
        <Label styleClass="form-header-icon" text="" />
        <VBox spacing="2">
            <Label fx:id="lblTitle" 
                   styleClass="form-header-title"
                   text="Chi Tiết Dịch Vụ" />
            <Label styleClass="form-header-subtitle"
                   text="Xem, chỉnh sửa hoặc xóa thông tin dịch vụ" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- BODY -->
    <VBox spacing="16" styleClass="form-body" fx:id="formContainer">

        <!-- SECTION: Mã & Tên Dịch Vụ -->
        <Label styleClass="form-section-title" text="Thông Tin Cơ Bản" />

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Mã Dịch Vụ" />
                <TextField fx:id="txtServiceId" 
                          editable="false" 
                          styleClass="form-field, form-field-readonly" />
            </VBox>
        </HBox>

        <VBox spacing="4">
            <Label styleClass="form-label" text="Tên Dịch Vụ *" />
            <TextField fx:id="txtServiceName" 
                      promptText="Nhập tên dịch vụ" 
                      styleClass="form-field" />
            <Label fx:id="lblServiceNameError" styleClass="form-error" text="" />
        </VBox>

        <Separator styleClass="form-divider" />

        <!-- SECTION: Phân Loại -->
        <Label styleClass="form-section-title" text="Phân Loại Dịch Vụ" />

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Loại Dịch Vụ *" />
                <ComboBox fx:id="cmbCategory" styleClass="form-combo" />
                <Label fx:id="lblCategoryError" styleClass="form-error" text="" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Loài" />
                <ComboBox fx:id="cmbSpecies" 
                          promptText="Chọn loài" 
                          prefWidth="200"
                          styleClass="form-combo" />
                <Label fx:id="lblSpeciesError" styleClass="form-error" text="" />
            </VBox>
        </HBox>

        <Separator styleClass="form-divider" />

        <!-- SECTION: Giá & Thời Gian -->
        <Label styleClass="form-section-title" text="Giá &amp; Thời Lượng" />

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Giá Cơ Bản (VNĐ) *" />
                <TextField fx:id="txtPrice" 
                          promptText="Nhập giá dịch vụ" 
                          styleClass="form-field" />
                <Label fx:id="lblPriceError" styleClass="form-error" text="" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Thời Gian (Phút) *" />
                <TextField fx:id="txtDuration" 
                          promptText="Nhập thời gian" 
                          styleClass="form-field" />
                <Label fx:id="lblDurationError" styleClass="form-error" text="" />
            </VBox>
        </HBox>

        <Label styleClass="form-hint" 
               text="Thông tin được đánh dấu (*) là bắt buộc" />

        <Separator styleClass="form-divider" />

        <!-- SECTION: Trạng Thái Dịch Vụ -->
        <Label styleClass="form-section-title" text="Trạng Thái Dịch Vụ" />

        <HBox spacing="14" alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Tình Trạng" />
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="lblStatusDisplay" 
                           styleClass="status-badge"
                           text="Đang hoạt động" />
                </HBox>
            </VBox>
        </HBox>

        <HBox spacing="10">
            <Button fx:id="btnActivateService" 
                    onAction="#handleActivateService" 
                    styleClass="btn-success" 
                    text="✓ Kích Hoạt" 
                    visible="false" />
            <Button fx:id="btnDeactivateService" 
                    onAction="#handleDeactivateService" 
                    styleClass="btn-warning" 
                    text="✗ Vô Hiệu Hóa" 
                    visible="false" />
        </HBox>

    </VBox>

    <!-- FOOTER -->
    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="form-footer">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnDelete" 
                onAction="#handleDelete" 
                styleClass="btn-danger" 
                text="Xóa Dịch Vụ" 
                visible="false" />
        <Button onAction="#handleCancel" 
                styleClass="btn-secondary" 
                text="Đóng" />
        <Button fx:id="btnSave" 
                onAction="#handleSave" 
                styleClass="btn-primary" 
                text="Lưu Thay Đổi" 
                visible="false" />
    </HBox>

</VBox>
