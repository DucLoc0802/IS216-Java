<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="main-content"
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.PetController">

    <HBox fx:id="headerBar" alignment="CENTER_LEFT" spacing="12">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Region styleClass="section-header-line"/>
            <VBox spacing="2">
                <Label text="Quản Lý Thú Cưng" styleClass="section-header"/>
                <Label text="Danh sách thú cưng toàn hệ thống" styleClass="ph-page-subtitle"/>
            </VBox>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAddPet" text="Thêm Thú Cưng" styleClass="action-btn action-btn-primary"
                onAction="#onAddPet"/>
    </HBox>

    <HBox spacing="14">
        <VBox styleClass="stat-card stat-card-brown" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="" styleClass="stat-icon"/>
                <VBox spacing="2">
                    <Label text="Tổng Thú Cưng" styleClass="stat-label"/>
                    <Label fx:id="statTotalPets" text="-" styleClass="stat-value"/>
                </VBox>
            </HBox>
            <Label text="Đang đăng ký trong hệ thống" styleClass="stat-sublabel"/>
        </VBox>
        <VBox styleClass="stat-card stat-card-green" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="" styleClass="stat-icon"/>
                <VBox spacing="2">
                    <Label text="Đang Ở Khách Sạn" styleClass="stat-label"/>
                    <Label fx:id="statPetsStaying" text="-" styleClass="stat-value"/>
                </VBox>
            </HBox>
            <Label text="Check-in hiện tại" styleClass="stat-sublabel"/>
        </VBox>
        <VBox styleClass="stat-card stat-card-amber" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="" styleClass="stat-icon"/>
                <VBox spacing="2">
                    <Label text="Grooming Hôm Nay" styleClass="stat-label"/>
                    <Label fx:id="statPetsGrooming" text="-" styleClass="stat-value"/>
                </VBox>
            </HBox>
            <Label text="Lịch grooming trong ngày" styleClass="stat-sublabel"/>
        </VBox>
        <VBox styleClass="stat-card stat-card-red" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="" styleClass="stat-icon"/>
                <VBox spacing="2">
                    <Label text="Cần Theo Dõi Sức Khỏe" styleClass="stat-label"/>
                    <Label fx:id="statPetsMonitoring" text="-" styleClass="stat-value"/>
                </VBox>
            </HBox>
            <Label text="Thú cưng cần chú ý" styleClass="stat-sublabel"/>
        </VBox>
    </HBox>

    <HBox styleClass="filter-bar ph-pet-filter-bar" alignment="CENTER_LEFT" spacing="12">
        <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
            <Label text="" styleClass="search-icon"/>
            <TextField fx:id="searchField"
                       promptText="Tìm theo mã, tên thú cưng, loài, giống, chủ sở hữu..."
                       styleClass="search-input"
                       HBox.hgrow="ALWAYS"
                       onAction="#onSearch"/>
        </HBox>

        <ComboBox fx:id="filterSpecies" styleClass="filter-combo ph-pet-filter-combo" prefWidth="160" promptText="Loại thú">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Tất cả"/>
                    <String fx:value="Chó"/>
                    <String fx:value="Mèo"/>
                    <String fx:value="Khác"/>
                </FXCollections>
            </items>
        </ComboBox>

        <ComboBox fx:id="filterHealth" styleClass="filter-combo ph-pet-filter-combo" prefWidth="160" promptText="Sức khỏe">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Tất cả"/>
                    <String fx:value="Bình thường"/>
                    <String fx:value="Cần theo dõi"/>
                    <String fx:value="Bất thường"/>
                </FXCollections>
            </items>
        </ComboBox>

        <Button text="Tìm" prefWidth="90" styleClass="action-btn action-btn-primary" onAction="#onSearch"/>
        <Button text="Xóa lọc" prefWidth="100" styleClass="action-btn action-btn-outline" onAction="#onClearFilter"/>
    </HBox>

    <VBox styleClass="content-panel" spacing="12" VBox.vgrow="ALWAYS">
        <TableView fx:id="petTable" styleClass="data-table ph-pet-table" VBox.vgrow="ALWAYS"
                   onMouseClicked="#onTableClick">
            <columns>
                <TableColumn fx:id="colPetId" text="Mã thú cưng" prefWidth="130"/>
                <TableColumn fx:id="colPetName" text="Tên thú cưng" prefWidth="180"/>
                <TableColumn fx:id="colPetSpecies" text="Loài / Giống" prefWidth="210"/>
                <TableColumn fx:id="colPetOwner" text="Chủ sở hữu" prefWidth="260"/>
                <TableColumn fx:id="colPetHealth" text="Sức khỏe" prefWidth="180"/>
            </columns>
            <placeholder>
                <VBox alignment="CENTER" spacing="8">
                    <Label text="Không tìm thấy thú cưng nào" styleClass="table-empty"/>
                </VBox>
            </placeholder>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label fx:id="pageInfo" text="Hiển thị 0 / 0 thú cưng" styleClass="ph-page-info"/>
            <Pagination fx:id="pagination" pageCount="1" maxPageIndicatorCount="5"/>
        </HBox>
    </VBox>
</VBox>
