<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- grooming-management.fxml | Controller: GroomingController -->

<VBox spacing="18" styleClass="main-content" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PetHotel.gui.controller.GroomingController">

    <HBox alignment="CENTER_LEFT" spacing="8" stylesheets="@../css/style.css">
        <Region styleClass="section-header-line" />
        <Label styleClass="section-header" text="Quản Lý Lịch Grooming" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onCreateGrooming" 
                fx:id="btnCreateGrooming"
                styleClass="action-btn action-btn-primary" 
                text="Đặt Lịch Grooming" />
        <Button fx:id="btnAssignGroomingStaff"
            text="Phân Công Nhân Viên"
            onAction="#onOpenStaffAssignment"
            styleClass="action-btn action-btn-primary"/>
    </HBox>

    <!-- Date navigator -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="filter-bar">
        <Button onAction="#onPrevDay" style="-fx-padding: 6 12 6 12;" styleClass="action-btn action-btn-outline" text="Trước" />
        <DatePicker fx:id="selectedDate" prefWidth="160" styleClass="filter-combo" />
        <Button onAction="#onNextDay" style="-fx-padding: 6 12 6 12;" styleClass="action-btn action-btn-outline" text="Sau" />
        <Button onAction="#onToday" style="-fx-padding: 6 14 6 14;" styleClass="action-btn action-btn-outline" text="Hôm Nay" />
        <Button onAction="#onViewAllSchedules" style="-fx-padding: 6 14 6 14;" styleClass="action-btn action-btn-outline" text="Xem Tất Cả Lịch" />
        <Region HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="filterStaff" prefWidth="170" promptText="Nhân viên thực hiện" styleClass="filter-combo" />
        <ComboBox fx:id="filterGroomStatus" prefWidth="140" promptText="Trạng thái" styleClass="filter-combo" />
    </HBox>

    <HBox spacing="18">
        <!-- Schedule list -->
        <VBox spacing="12" styleClass="content-panel" HBox.hgrow="ALWAYS">
            <Label fx:id="panelTitle" styleClass="panel-title" text="Lịch Grooming Hôm Nay" />
            <TableView fx:id="groomingTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colGrId" prefWidth="70" text="Mã" />
                    <TableColumn fx:id="colGrTime" prefWidth="80" text="Giờ" />
                    <TableColumn fx:id="colGrPet" prefWidth="120" text="Thú Cưng" />
                    <TableColumn fx:id="colGrOwner" prefWidth="120" text="Chủ" />
                    <TableColumn fx:id="colGrService" prefWidth="150" text="Dịch Vụ" />
                    <TableColumn fx:id="colGrStaff" prefWidth="160" text="Nhân Viên (ID - Tên)" />
                    <TableColumn fx:id="colGrStatus" prefWidth="110" text="Trạng Thái" />
                    <TableColumn fx:id="colGrAction" prefWidth="120" resizable="false" text="Thao Tác" />
                </columns>
                <placeholder>
                    <Label styleClass="table-empty" text="Không có lịch grooming" />
                </placeholder>
            </TableView>
        </VBox>

        <!-- Staff workload sidebar -->
        <VBox prefWidth="260" spacing="12" styleClass="content-panel">
            <Label styleClass="panel-title" text="Nhân Viên Hôm Nay" />
            <VBox fx:id="staffWorkloadList" spacing="8">
                <!-- Populated by controller -->
            </VBox>
        </VBox>
    </HBox>

</VBox>
