<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  RoomDetailDialog.fxml — UC-ROOM-03: Xem chi tiết phòng
  Controller: PetHotel.gui.controller.RoomDetailController
-->

<VBox maxWidth="520" prefWidth="520" spacing="0"
      styleClass="form-root"
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.RoomDetailController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
        <VBox spacing="2">
            <Label styleClass="form-header-title" text="Chi Tiết Phòng" />
            <Label styleClass="form-header-subtitle" text="Thông tin chi tiết phòng lưu trú" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onClose" styleClass="form-close-btn" text="✕" />
    </HBox>

    <!-- BODY -->
    <VBox spacing="16" styleClass="form-body">

        <Label styleClass="form-section-title" text="Thông Tin Phòng" />

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Mã Phòng" />
                <Label fx:id="lblRoomId" styleClass="form-detail-value" text="—" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Số Phòng" />
                <Label fx:id="lblRoomNumber" styleClass="form-detail-value" text="—" />
            </VBox>
        </HBox>

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Loại Phòng" />
                <Label fx:id="lblTypeName" styleClass="form-detail-value" text="—" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Trạng Thái" />
                <Label fx:id="lblStatus" styleClass="form-detail-value" text="—" />
            </VBox>
        </HBox>

        <Separator styleClass="form-divider" />

        <Label styleClass="form-section-title" text="Thông Tin Loại Phòng" />

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Giá / Ngày (VNĐ)" />
                <Label fx:id="lblPrice" styleClass="form-detail-value" text="—" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Sức Chứa (Thú Cưng)" />
                <Label fx:id="lblMaxPets" styleClass="form-detail-value" text="—" />
            </VBox>
        </HBox>

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Trọng Lượng Tối Đa (kg)" />
                <Label fx:id="lblMaxWeight" styleClass="form-detail-value" text="—" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Chi Nhánh" />
                <Label fx:id="lblBranchId" styleClass="form-detail-value" text="—" />
            </VBox>
        </HBox>

    </VBox>

    <!-- FOOTER -->
    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="form-footer">
        <Button fx:id="btnClose" onAction="#onClose" styleClass="btn-secondary" text="Đóng" />
    </HBox>
</VBox>
