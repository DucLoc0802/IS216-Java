<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  EditBookingDialog.fxml — UC-BOOK-04: Chỉnh sửa booking
  Controller: PetHotel.gui.controller.EditBookingController
-->

<VBox maxWidth="560" prefWidth="560" spacing="0"
      styleClass="form-root"
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.EditBookingController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
        <VBox spacing="2">
            <Label styleClass="form-header-title" text="Chỉnh Sửa Booking" />
            <Label fx:id="lblBookingId" styleClass="form-header-subtitle" text="Mã booking: —" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onCancel" styleClass="form-close-btn" text="✕" />
    </HBox>

    <!-- BODY -->
    <VBox spacing="16" styleClass="form-body">

        <!-- Thông tin tham chiếu (chỉ đọc) -->
        <Label styleClass="form-section-title" text="Thông Tin Tham Chiếu" />

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Khách Hàng" />
                <Label fx:id="lblCustomer" styleClass="form-detail-value" text="—" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Thú Cưng" />
                <Label fx:id="lblPet" styleClass="form-detail-value" text="—" />
            </VBox>
        </HBox>

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Phòng *" />
                <ComboBox fx:id="cbRoom" prefWidth="200" styleClass="form-combo" maxWidth="1.7976931348623157E308" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Trạng Thái Hiện Tại" />
                <Label fx:id="lblStatus" styleClass="form-detail-value" text="—" />
            </VBox>
        </HBox>

        <Separator styleClass="form-divider" />

        <!-- Ngày check-in / check-out -->
        <Label styleClass="form-section-title" text="Ngày Check-in / Check-out" />

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Ngày Check-in *" />
                <DatePicker fx:id="dateCheckin" styleClass="form-combo" maxWidth="1.7976931348623157E308" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Ngày Check-out *" />
                <DatePicker fx:id="dateCheckout" styleClass="form-combo" maxWidth="1.7976931348623157E308" />
            </VBox>
        </HBox>

        <Separator styleClass="form-divider" />

        <!-- Thanh toán -->
        <Label styleClass="form-section-title" text="Thanh Toán" />

        <VBox spacing="4">
            <Label styleClass="form-label" text="Đặt Cọc (VNĐ)" />
            <TextField fx:id="txtDeposit" styleClass="form-field" promptText="0" />
            <Label styleClass="form-hint" text="Số tiền đặt cọc" />
        </VBox>

        <Separator styleClass="form-divider" />

        <!-- Ghi chú -->
        <Label styleClass="form-section-title" text="Ghi Chú" />

        <VBox spacing="4">
            <Label styleClass="form-label" text="Ghi chú bổ sung" />
            <TextArea fx:id="txtNote" styleClass="form-area" prefRowCount="3" wrapText="true"
                      promptText="Ví dụ: yêu cầu đặc biệt, chú ý sức khỏe..." />
            <Label styleClass="form-hint" text="Không bắt buộc" />
        </VBox>

        <!-- ERROR -->
        <Label fx:id="lblError" styleClass="form-error" text="" wrapText="true" visible="false" />

    </VBox>

    <!-- FOOTER -->
    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="form-footer">
        <Button fx:id="btnCancel" onAction="#onCancel" styleClass="btn-secondary" text="Hủy" />
        <Button onAction="#onSave" styleClass="btn-primary" text="Lưu Thay Đổi" />
    </HBox>
</VBox>
