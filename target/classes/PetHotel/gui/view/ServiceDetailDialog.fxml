<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  ServiceDetailDialog.fxml — Dialog xem/sửa/xóa chi tiết dịch vụ
  Controller: PetHotel.gui.controller.ServiceDetailController
  
  Dành cho vai trò: Quản lý chi nhánh
  
  Chức năng:
   - Xem thông tin chi tiết dịch vụ
   - Sửa thông tin dịch vụ
   - Xóa dịch vụ (đánh dấu là không hoạt động)
-->

<VBox spacing="16" styleClass="dialog-content" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PetHotel.gui.controller.ServiceDetailController">

    <!-- Tiêu đề dialog -->
    <Label fx:id="lblTitle" styleClass="dialog-title" text="Chi Tiết Dịch Vụ" />

    <!-- Form thông tin dịch vụ -->
    <VBox spacing="12" fx:id="formContainer">

        <!-- Mã dịch vụ (chỉ đọc) -->
        <VBox spacing="4">
            <Label styleClass="form-label" text="Mã Dịch Vụ" />
            <TextField fx:id="txtServiceId" editable="false" maxWidth="Infinity" styleClass="form-input" />
        </VBox>

        <!-- Tên dịch vụ -->
        <VBox spacing="4">
            <Label styleClass="form-label" text="Tên Dịch Vụ *" />
            <TextField fx:id="txtServiceName" maxWidth="Infinity" promptText="Nhập tên dịch vụ" styleClass="form-input" />
            <Label fx:id="lblServiceNameError" styleClass="error-message" text="" />
        </VBox>

        <!-- Loại dịch vụ (Category) -->
        <VBox spacing="4">
            <Label styleClass="form-label" text="Loại Dịch Vụ *" />
            <ComboBox fx:id="cmbCategory" maxWidth="Infinity" styleClass="form-input" />
            <Label fx:id="lblCategoryError" styleClass="error-message" text="" />
        </VBox>

        <!-- Loài (Species) -->
        <VBox spacing="4">
            <Label styleClass="form-label" text="Loài" />
            <TextField fx:id="txtSpecies" maxWidth="Infinity" promptText="VD: Chó, Mèo, Chim..." styleClass="form-input" />
            <Label fx:id="lblSpeciesError" styleClass="error-message" text="" />
        </VBox>

        <!-- Giá dịch vụ -->
        <VBox spacing="4">
            <Label styleClass="form-label" text="Giá Cơ Bản (VNĐ) *" />
            <TextField fx:id="txtPrice" maxWidth="Infinity" promptText="Nhập giá dịch vụ" styleClass="form-input" />
            <Label fx:id="lblPriceError" styleClass="error-message" text="" />
        </VBox>

        <!-- Thời gian dịch vụ -->
        <VBox spacing="4">
            <Label styleClass="form-label" text="Thời Gian (Phút) *" />
            <TextField fx:id="txtDuration" maxWidth="Infinity" promptText="Nhập thời gian (phút)" styleClass="form-input" />
            <Label fx:id="lblDurationError" styleClass="error-message" text="" />
        </VBox>

    </VBox>

    <!-- Nút thao tác -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnDelete" onAction="#handleDelete" styleClass="action-btn action-btn-danger" style="-fx-padding: 8 16 8 16;" text="Xóa Dịch Vụ" visible="false" />
        <Button onAction="#handleCancel" styleClass="action-btn action-btn-outline" text="Đóng" />
        <Button fx:id="btnSave" onAction="#handleSave" styleClass="action-btn action-btn-primary" text="Lưu Thay Đổi" visible="false" />
    </HBox>

    <Label styleClass="info-text" text="Thông tin được đánh dấu (*) là bắt buộc." />

</VBox>
