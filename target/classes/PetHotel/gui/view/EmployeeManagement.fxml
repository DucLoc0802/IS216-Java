<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="20" styleClass="main-content"
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.EmployeeController">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Region styleClass="section-header-line"/>
            <VBox spacing="2">
                <Label text="Quản Lý Nhân Viên" styleClass="section-header"/>
                <Label text="Hồ sơ · Hiệu suất · Trạng thái hoạt động"
                       style="-fx-font-size:11px; -fx-text-fill:-ph-text-muted;"/>
            </VBox>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Thêm Nhân Viên" styleClass="action-btn action-btn-primary"
                onAction="#onAddEmployee"/>
    </HBox>

    <HBox spacing="14">
        <VBox styleClass="stat-card stat-card-brown" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="👥" styleClass="stat-icon"/>
                <VBox spacing="2">
                    <Label text="Tổng Nhân Viên" styleClass="stat-label"/>
                    <Label fx:id="statTotal" text="—" styleClass="stat-value"/>
                </VBox>
            </HBox>
            <Label text="Toàn bộ hệ thống" styleClass="stat-sublabel"/>
        </VBox>

        <VBox styleClass="stat-card stat-card-green" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="✅" styleClass="stat-icon"/>
                <VBox spacing="2">
                    <Label text="Đang Hoạt Động" styleClass="stat-label"/>
                    <Label fx:id="statActive" text="—" styleClass="stat-value"/>
                </VBox>
            </HBox>
            <Label text="Nhân viên đang làm việc" styleClass="stat-sublabel"/>
        </VBox>

        <VBox styleClass="stat-card stat-card-red" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="⏸" styleClass="stat-icon"/>
                <VBox spacing="2">
                    <Label text="Ngưng Hoạt Động" styleClass="stat-label"/>
                    <Label fx:id="statInactive" text="—" styleClass="stat-value"/>
                </VBox>
            </HBox>
            <Label text="Tạm thời / nghỉ việc" styleClass="stat-sublabel"/>
        </VBox>

        <VBox styleClass="stat-card stat-card-purple" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="✂️" styleClass="stat-icon"/>
                <VBox spacing="2">
                    <Label text="Groomer" styleClass="stat-label"/>
                    <Label fx:id="statGroomers" text="—" styleClass="stat-value"/>
                </VBox>
            </HBox>
            <Label text="Nhân viên grooming" styleClass="stat-sublabel"/>
        </VBox>

        <VBox styleClass="stat-card stat-card-blue" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="🏅" styleClass="stat-icon"/>
                <VBox spacing="2">
                    <Label text="Hiệu Suất TB" styleClass="stat-label"/>
                    <Label fx:id="statAvgPerf" text="—" styleClass="stat-value"/>
                </VBox>
            </HBox>
            <Label text="Điểm trung bình tháng này" styleClass="stat-sublabel"/>
        </VBox>
    </HBox>

    <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="12">
        <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
            <Label text="🔍" styleClass="search-icon"/>
            <TextField fx:id="searchField"
                       promptText="Tìm theo tên, mã NV, SĐT, email..."
                       styleClass="search-input" HBox.hgrow="ALWAYS"
                       onAction="#onSearch"/>
        </HBox>

        <VBox spacing="3">
            <Label text="Chức vụ" styleClass="filter-label"/>
            <ComboBox fx:id="filterRole" styleClass="filter-combo" prefWidth="150"
                      promptText="Tất cả">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Tất cả"/>
                        <String fx:value="Lễ Tân"/>
                        <String fx:value="Groomer"/>
                        <String fx:value="Chăm Sóc Thú"/>
                        <String fx:value="Quản Lý"/>
                        <String fx:value="Kế Toán"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>

        <VBox spacing="3">
            <Label text="Trạng thái" styleClass="filter-label"/>
            <ComboBox fx:id="filterStatus" styleClass="filter-combo" prefWidth="140"
                      promptText="Tất cả">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Tất cả"/>
                        <String fx:value="Đang hoạt động"/>
                        <String fx:value="Ngưng hoạt động"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>

        <VBox spacing="3">
            <Label text="Chi nhánh" styleClass="filter-label"/>
            <ComboBox fx:id="filterBranch" styleClass="filter-combo" prefWidth="140"
                      promptText="Tất cả CN"/>
        </VBox>

        <Button text="Tìm" styleClass="action-btn action-btn-primary"
                onAction="#onSearch" style="-fx-padding:7 18 7 18;"/>
        <Button text="Xóa lọc" styleClass="action-btn action-btn-outline"
                onAction="#onClearFilter" style="-fx-padding:7 14 7 14;"/>
    </HBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">

        <VBox styleClass="content-panel" HBox.hgrow="ALWAYS" spacing="12">

            <HBox styleClass="action-toolbar" alignment="CENTER_LEFT">
                <Button fx:id="btnEdit"       text="✏ Sửa"           styleClass="action-btn action-btn-outline"
                        onAction="#onEditEmployee"    disable="true"/>
                <Button fx:id="btnDeactivate" text="⏸ Ngưng HĐ"     styleClass="action-btn action-btn-danger"
                        onAction="#onDeactivateEmployee" disable="true"/>
                <Button fx:id="btnActivate"   text="▶ Kích Hoạt"     styleClass="action-btn action-btn-success"
                        onAction="#onActivateEmployee"   disable="true"/>
                <Button fx:id="btnPerf"       text="📊 Hiệu Suất"    styleClass="action-btn action-btn-outline"
                        onAction="#onViewPerformance"    disable="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="selectionInfo" text=""
                       style="-fx-font-size:11px; -fx-text-fill:-ph-text-muted;"/>
            </HBox>

            <TableView fx:id="employeeTable" styleClass="data-table" VBox.vgrow="ALWAYS"
                       onMouseClicked="#onTableClick">
                <columns>
                    <TableColumn fx:id="colAvatar"    text=""              prefWidth="46"  resizable="false"/>
                    <TableColumn fx:id="colEmpId"     text="Mã NV"         prefWidth="80"/>
                    <TableColumn fx:id="colEmpName"   text="Họ Tên"        prefWidth="155"/>
                    <TableColumn fx:id="colEmpRole"   text="Chức Vụ"       prefWidth="130"/>
                    <TableColumn fx:id="colEmpBranch" text="Chi Nhánh"    prefWidth="120"/>
                    <TableColumn fx:id="colEmpPhone"  text="SĐT"           prefWidth="110"/>
                    <TableColumn fx:id="colEmpPerf"   text="Hiệu Suất"    prefWidth="100"/>
                    <TableColumn fx:id="colEmpStatus" text="Trạng Thái"   prefWidth="110"/>
                    <TableColumn fx:id="colEmpAction" text="Thao Tác"     prefWidth="100" resizable="false"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="8">
                        <Label text="👥" style="-fx-font-size:28px;"/>
                        <Label text="Không tìm thấy nhân viên nào" styleClass="table-empty"/>
                    </VBox>
                </placeholder>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label fx:id="pageInfo" text="Hiển thị 0 / 0 nhân viên"
                       style="-fx-font-size:11px; -fx-text-fill:-ph-text-muted;"/>
                <Pagination fx:id="pagination" pageCount="1" maxPageIndicatorCount="5"/>
            </HBox>
        </VBox>

        <VBox fx:id="detailPanel" prefWidth="330" minWidth="310" spacing="14">

            <VBox styleClass="content-panel" spacing="14">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Region styleClass="section-header-line"/>
                    <Label text="Hồ Sơ Nhân Viên" styleClass="panel-title"/>
                </HBox>

                <VBox alignment="CENTER" spacing="8" style="-fx-padding:8 0 6 0;">
                    <Label fx:id="detailAvatar" text="NV"
                           style="-fx-background-color:-ph-brown; -fx-background-radius:30px;
                                  -fx-min-width:58px; -fx-max-width:58px;
                                  -fx-min-height:58px; -fx-max-height:58px;
                                  -fx-alignment:center; -fx-text-fill:white;
                                  -fx-font-size:18px; -fx-font-weight:bold;"/>
                    <Label fx:id="detailName"   text="—" styleClass="detail-name"/>
                    <HBox alignment="CENTER" spacing="6">
                        <Label fx:id="detailRole"   text="—" styleClass="status-badge status-staff"/>
                        <Label fx:id="detailStatus" text="—" styleClass="status-badge status-active"/>
                    </HBox>
                </VBox>

                <Separator styleClass="detail-divider"/>

                <GridPane hgap="10" vgap="8">
                    <Label text="Mã NV"       styleClass="detail-key" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="detailId"       text="—" styleClass="detail-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="CCCD"        styleClass="detail-key" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="detailCCCD"     text="—" styleClass="detail-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Ngày sinh"   styleClass="detail-key" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="detailDob"      text="—" styleClass="detail-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="SĐT"         styleClass="detail-key" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="detailPhone"    text="—" styleClass="detail-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Email"       styleClass="detail-key" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <Label fx:id="detailEmail"    text="—" styleClass="detail-value" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Chi nhánh"  styleClass="detail-key" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <Label fx:id="detailBranch"   text="—" styleClass="detail-value" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Ngày vào"   styleClass="detail-key" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <Label fx:id="detailJoinDate" text="—" styleClass="detail-value" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <Label text="Địa chỉ"   styleClass="detail-key" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <Label fx:id="detailAddress"  text="—" styleClass="detail-value"
                           wrapText="true" maxWidth="180"
                           GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                    <columnConstraints>
                        <ColumnConstraints prefWidth="90" minWidth="80"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                </GridPane>

                <Separator styleClass="detail-divider"/>
                <HBox spacing="8">
                    <Button fx:id="btnDetailEdit"  text="✏ Sửa"    styleClass="action-btn action-btn-outline"
                            onAction="#onEditEmployee"     disable="true"/>
                    <Button fx:id="btnDetailDeact" text="⏸ Ngưng"  styleClass="action-btn action-btn-danger"
                            onAction="#onDeactivateEmployee" disable="true"/>
                    <Button fx:id="btnDetailPerf"  text="📊 Hiệu Suất" styleClass="action-btn action-btn-outline"
                            onAction="#onViewPerformance"   disable="true"/>
                </HBox>

                <VBox fx:id="noSelectionHint" styleClass="no-selection-hint" spacing="8">
                    <Label text="👤" style="-fx-font-size:26px;"/>
                    <Label text="Chọn nhân viên để xem hồ sơ"
                           style="-fx-font-size:12px; -fx-text-fill:-ph-text-muted; -fx-text-alignment:center;"
                           wrapText="true" maxWidth="200" textAlignment="CENTER"/>
                </VBox>
            </VBox>

            <VBox styleClass="content-panel" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Region styleClass="section-header-line"/>
                    <Label text="Thống Kê Hiệu Suất" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="perfPeriod" styleClass="filter-combo" prefWidth="110"
                              promptText="Tháng này">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Tháng này"/>
                                <String fx:value="Tháng trước"/>
                                <String fx:value="Quý này"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </HBox>

                <HBox spacing="8">
                    <VBox styleClass="room-stat-box room-stat-available" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                        <Label fx:id="perfGrooming" text="—" styleClass="room-stat-num"/>
                        <Label text="Grooming" styleClass="room-stat-label"/>
                    </VBox>
                    <VBox styleClass="room-stat-box room-stat-occupied" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                        <Label fx:id="perfCheckin"  text="—" styleClass="room-stat-num"/>
                        <Label text="Check-in"  styleClass="room-stat-label"/>
                    </VBox>
                    <VBox styleClass="room-stat-box room-stat-cleaning" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                        <Label fx:id="perfRating"   text="—" styleClass="room-stat-num"/>
                        <Label text="Đánh giá"  styleClass="room-stat-label"/>
                    </VBox>
                </HBox>

                <VBox styleClass="chart-placeholder" prefHeight="100" alignment="CENTER" spacing="6">
                    <Label text="📈" styleClass="chart-placeholder-icon"/>
                    <Label text="Biểu đồ hiệu suất&#10;sẽ hiển thị tại đây"
                           styleClass="chart-placeholder-label" textAlignment="CENTER"/>
                </VBox>
            </VBox>

        </VBox>
    </HBox>

</VBox>