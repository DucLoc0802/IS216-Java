<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  topbar.fxml — Top bar (dùng chung toàn hệ thống)
  Include vào Dashboard.fxml bằng: <fx:include source="topbar.fxml"/>
  Các fx:id được inject vào DashboardController qua nested controller.
-->

<HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PetHotel.gui.controller.TopbarController">

    <!-- Page title + breadcrumb -->
    <VBox spacing="2">
        <Label fx:id="pageTitle" styleClass="page-title" text="Dashboard" />
        <Label fx:id="pageBreadcrumb" styleClass="page-breadcrumb" text="Trang chủ" />
    </VBox>

    <Region HBox.hgrow="ALWAYS" />

    <!-- Global search -->
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-box">
        <Label styleClass="search-icon" text="🔍" />
        <TextField fx:id="globalSearch" onAction="#onSearch" promptText="Tìm kiếm nhanh..." styleClass="search-input" />
    </HBox>

    <!-- Notification bell -->
    <StackPane onMouseClicked="#onNotification" styleClass="notif-wrapper">
        <Button styleClass="topbar-icon-btn" text="🔔" />
        <Label fx:id="notifBadge" styleClass="notif-badge" text="3" />
    </StackPane>

    <!-- Branch selector -->
    <HBox alignment="CENTER" onMouseClicked="#onBranchSwitch" spacing="6" styleClass="branch-selector">
        <Label styleClass="branch-icon" text="📍" />
        <Label fx:id="currentBranch" styleClass="branch-label" text="Chi Nhánh Q.1" />
        <Label styleClass="branch-arrow" text="▾" />
    </HBox>

    <!-- Date / Time -->
    <VBox alignment="CENTER_RIGHT" spacing="2" styleClass="datetime-box">
        <Label fx:id="currentDate" styleClass="date-label" text="02/05/2026" />
        <Label fx:id="currentTime" styleClass="time-label" text="08:30" />
    </VBox>

</HBox>
