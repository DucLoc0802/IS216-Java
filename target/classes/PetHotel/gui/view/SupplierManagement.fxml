<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="20" styleClass="main-content"
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="PetHotel.gui.controller.SupplierController">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Region styleClass="section-header-line"/>
            <VBox spacing="2">
                <Label text="Quản Lý Nhà Cung Cấp" styleClass="section-header"/>
                <Label text="Thông tin và lịch sử giao dịch nhà cung cấp"
                       style="-fx-font-size:11px; -fx-text-fill: -ph-text-muted;"/>
            </VBox>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Thêm Nhà Cung Cấp" styleClass="action-btn action-btn-primary"
                onAction="#onAddSupplier"/>
    </HBox>

    <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="12">
        <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
            <Label text="" styleClass="search-icon"/>
            <TextField fx:id="searchField"
                       promptText="Tìm theo tên, mã, địa chỉ, số điện thoại..."
                       styleClass="search-input" HBox.hgrow="ALWAYS"
                       onAction="#onSearch"/>
        </HBox>
        <VBox spacing="3">
            <Label text="Trạng thái" styleClass="filter-label"/>
            <ComboBox fx:id="filterStatus" styleClass="filter-combo" prefWidth="140"
                      promptText="Tất cả">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Tất cả"/>
                        <String fx:value="Đang hợp tác"/>
                        <String fx:value="Ngưng hợp tác"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
        <Button text="Tìm" styleClass="action-btn action-btn-primary"
                onAction="#onSearch" style="-fx-padding: 7 18 7 18;"/>
        <Button text="Xóa lọc" styleClass="action-btn action-btn-outline"
                onAction="#onClearFilter" style="-fx-padding: 7 14 7 14;"/>
    </HBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">

        <VBox styleClass="content-panel" HBox.hgrow="ALWAYS" spacing="12">

            <HBox styleClass="action-toolbar" alignment="CENTER_LEFT">
                <Button fx:id="btnEdit"   text="Sửa"          styleClass="action-btn action-btn-outline"
                        onAction="#onEditSupplier"   disable="true"/>
                <Button fx:id="btnDelete" text="Xóa"          styleClass="action-btn action-btn-danger"
                        onAction="#onDeleteSupplier" disable="true"/>
                <Button fx:id="btnDeactivate" text="Ngưng HT" styleClass="action-btn action-btn-amber"
                        onAction="#onDeactivate"     disable="true"/>
                <Button fx:id="btnHistory" text="Lịch Sử Nhập" styleClass="action-btn action-btn-outline"
                        onAction="#onViewHistory"    disable="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalLabel" text=""
                       style="-fx-font-size:11px; -fx-text-fill: -ph-text-muted;"/>
            </HBox>

            <TableView fx:id="supplierTable" styleClass="data-table" VBox.vgrow="ALWAYS"
                       onMouseClicked="#onTableClick">
                <columns>
                    <TableColumn fx:id="colSupId"       text="Mã NCC"          prefWidth="90"/>
                    <TableColumn fx:id="colSupName"     text="Tên Nhà Cung Cấp" prefWidth="200"/>
                    <TableColumn fx:id="colSupContact"  text="Người Liên Hệ"   prefWidth="140"/>
                    <TableColumn fx:id="colSupPhone"    text="SĐT"             prefWidth="120"/>
                    <TableColumn fx:id="colSupEmail"    text="Email"           prefWidth="170"/>
                    <TableColumn fx:id="colSupProducts" text="Số SP Cung Cấp"  prefWidth="130"/>
                    <TableColumn fx:id="colSupStatus"   text="Trạng Thái"      prefWidth="120"/>
                    <TableColumn fx:id="colSupActions"  text="Thao Tác"        prefWidth="100" resizable="false"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="8">
                        <Label text="" style="-fx-font-size:28px;"/>
                        <Label text="Không tìm thấy nhà cung cấp nào" styleClass="table-empty"/>
                    </VBox>
                </placeholder>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label fx:id="pageInfo" text="Hiển thị 0 / 0 nhà cung cấp"
                       style="-fx-font-size:11px; -fx-text-fill: -ph-text-muted;"/>
                <Pagination fx:id="pagination" pageCount="1" maxPageIndicatorCount="5"/>
            </HBox>
        </VBox>

        <VBox fx:id="detailPanel" prefWidth="310" minWidth="290" spacing="14">

            <VBox styleClass="content-panel" spacing="14">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Region styleClass="section-header-line"/>
                    <Label text="Thông Tin Nhà Cung Cấp" styleClass="panel-title"/>
                </HBox>

                <VBox alignment="CENTER" spacing="6" style="-fx-padding: 8 0 4 0;">
                    <Label fx:id="detailSupIcon" text="" style="-fx-font-size:34px;"/>
                    <Label fx:id="detailSupName" text="—" styleClass="detail-name"
                           wrapText="true" textAlignment="CENTER" maxWidth="270"/>
                    <Label fx:id="detailSupStatus" text="—" styleClass="status-badge status-active"/>
                </VBox>

                <Separator styleClass="detail-divider"/>

                <GridPane hgap="10" vgap="8">
                    <Label text="Mã NCC"      styleClass="detail-key" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="detailSupId"      text="—" styleClass="detail-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Liên hệ"    styleClass="detail-key" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="detailSupContact"  text="—" styleClass="detail-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="SĐT"        styleClass="detail-key" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="detailSupPhone"    text="—" styleClass="detail-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Email"      styleClass="detail-key" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="detailSupEmail"    text="—" styleClass="detail-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Địa chỉ"   styleClass="detail-key" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <Label fx:id="detailSupAddress"  text="—" styleClass="detail-value"
                           wrapText="true" maxWidth="175"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Ngân hàng" styleClass="detail-key" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <Label fx:id="detailSupBank"     text="—" styleClass="detail-value" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Ghi chú"   styleClass="detail-key" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <Label fx:id="detailSupNote"     text="—" styleClass="detail-value"
                           wrapText="true" maxWidth="175"
                           GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <columnConstraints>
                        <ColumnConstraints prefWidth="90" minWidth="80"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                </GridPane>

                <Separator styleClass="detail-divider"/>
                <HBox spacing="8">
                    <Button fx:id="btnDetailEdit"    text="Sửa"    styleClass="action-btn action-btn-outline"
                            onAction="#onEditSupplier" disable="true"/>
                    <Button fx:id="btnDetailHistory" text="Lịch Sử" styleClass="action-btn action-btn-outline"
                            onAction="#onViewHistory"  disable="true"/>
                </HBox>

                <VBox fx:id="noSelectionHint" styleClass="no-selection-hint" spacing="8">
                    <Label text="" style="-fx-font-size:26px;"/>
                    <Label text="Chọn nhà cung cấp để xem chi tiết"
                           style="-fx-font-size:12px; -fx-text-fill: -ph-text-muted; -fx-text-alignment:center;"
                           wrapText="true" maxWidth="200" textAlignment="CENTER"/>
                </VBox>
            </VBox>

            <VBox styleClass="content-panel" spacing="10" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Region styleClass="section-header-line"/>
                    <Label text="Sản Phẩm Cung Cấp" styleClass="panel-title"/>
                </HBox>
                <VBox fx:id="supplierProductList" spacing="6">
                    </VBox>
                <Label fx:id="supProdEmptyHint" text="Chưa có sản phẩm liên kết"
                       style="-fx-font-size:12px; -fx-text-fill: -ph-text-muted;"/>
            </VBox>

        </VBox>
    </HBox>

</VBox>