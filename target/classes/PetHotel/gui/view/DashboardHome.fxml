<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  dashboard-home.fxml — Trang chủ Dashboard
  Load vào ScrollPane#contentArea của Dashboard.fxml
  Controller: DashboardHomeController
-->

<VBox spacing="20" styleClass="main-content" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PetHotel.gui.controller.DashboardHomeController">

    <!-- ── STAT CARDS ──────────────────────────────────────── -->
    <VBox spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Region styleClass="section-header-line" />
            <Label styleClass="section-header" text="Tổng Quan Hôm Nay" />
        </HBox>

        <HBox spacing="14">
            <!-- Booking -->
            <VBox styleClass="stat-card stat-card-brown" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label styleClass="stat-icon" text="📅" />
                    <VBox spacing="2">
                        <Label styleClass="stat-label" text="Tổng Booking" />
                        <Label fx:id="statBookingTotal" styleClass="stat-value" text="—" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="statBookingDelta" styleClass="stat-delta stat-delta-up" text="" />
                        <Label styleClass="stat-delta-desc" text="so với hôm qua" />
                    </VBox>
                </HBox>
                <Label styleClass="stat-sublabel" text="Booking hôm nay" />
            </VBox>

            <!-- Rooms -->
            <VBox styleClass="stat-card stat-card-green" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label styleClass="stat-icon" text="🏠" />
                    <VBox spacing="2">
                        <Label styleClass="stat-label" text="Phòng Đang Dùng" />
                        <Label fx:id="statRoomOccupied" styleClass="stat-value" text="—" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="statRoomPct" styleClass="stat-delta" text="" />
                        <Label styleClass="stat-delta-desc" text="công suất" />
                    </VBox>
                </HBox>
                <Label styleClass="stat-sublabel" text="Phòng đang có thú cưng" />
            </VBox>

            <!-- Revenue -->
            <VBox styleClass="stat-card stat-card-amber" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label styleClass="stat-icon" text="💰" />
                    <VBox spacing="2">
                        <Label styleClass="stat-label" text="Doanh Thu Hôm Nay" />
                        <Label fx:id="statRevenue" styleClass="stat-value" text="—" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="statRevenueDelta" styleClass="stat-delta stat-delta-up" text="" />
                        <Label styleClass="stat-delta-desc" text="so với hôm qua" />
                    </VBox>
                </HBox>
                <Label styleClass="stat-sublabel" text="Tổng doanh thu ngày" />
            </VBox>

            <!-- Low stock -->
            <VBox styleClass="stat-card stat-card-red" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label styleClass="stat-icon" text="⚠️" />
                    <VBox spacing="2">
                        <Label styleClass="stat-label" text="Cảnh Báo Tồn Kho" />
                        <Label fx:id="statLowStock" styleClass="stat-value" text="—" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER_RIGHT">
                        <Label styleClass="stat-delta stat-delta-warn" text="Cần nhập" />
                        <Label styleClass="stat-delta-desc" text="ngay hôm nay" />
                    </VBox>
                </HBox>
                <Label styleClass="stat-sublabel" text="Sản phẩm tồn kho thấp" />
            </VBox>

            <!-- Grooming -->
            <VBox styleClass="stat-card stat-card-purple" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label styleClass="stat-icon" text="✂️" />
                    <VBox spacing="2">
                        <Label styleClass="stat-label" text="Grooming Chờ" />
                        <Label fx:id="statGroomingPending" styleClass="stat-value" text="—" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="statGroomingToday" styleClass="stat-delta" text="" />
                        <Label styleClass="stat-delta-desc" text="hôm nay" />
                    </VBox>
                </HBox>
                <Label styleClass="stat-sublabel" text="Lịch grooming chưa xong" />
            </VBox>
        </HBox>
    </VBox>

    <!-- ── QUICK ACTIONS ───────────────────────────────────── -->
    <VBox spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Region styleClass="section-header-line" />
            <Label styleClass="section-header" text="Quick Actions" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="action-toolbar">
            <Button onAction="#onQuickCreateBooking" styleClass="action-btn action-btn-primary" text="+ Tạo Booking" />
            <Button onAction="#onQuickCheckin" styleClass="action-btn action-btn-success" text="✔ Check-in" />
            <Button onAction="#onQuickCheckout" styleClass="action-btn action-btn-outline" text="↩ Check-out" />
            <Button onAction="#onQuickCreateInvoice" styleClass="action-btn action-btn-amber" text="+ Hóa Đơn" />
            <Button onAction="#onQuickAddCustomer" styleClass="action-btn action-btn-outline" text="+ Khách Hàng" />
            <Button onAction="#onQuickCheckRoom" styleClass="action-btn action-btn-outline" text="🏠 Kiểm Phòng" />
        </HBox>
    </VBox>

    <!-- ── TWO-COLUMN LAYOUT ───────────────────────────────── -->
    <HBox spacing="18">

        <!-- LEFT: Today's Booking table -->
        <VBox spacing="12" styleClass="content-panel" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Region styleClass="section-header-line" />
                    <Label styleClass="panel-title" text="Booking Hôm Nay" />
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onViewAllBooking" styleClass="panel-link-btn" text="Xem tất cả →" />
            </HBox>

            <TableView fx:id="todayBookingTable" prefHeight="260" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colBkId" prefWidth="60" text="Mã" />
                    <TableColumn fx:id="colBkPet" prefWidth="110" text="Thú Cưng" />
                    <TableColumn fx:id="colBkOwner" prefWidth="110" text="Chủ" />
                    <TableColumn fx:id="colBkRoom" prefWidth="70" text="Phòng" />
                    <TableColumn fx:id="colBkCkin" prefWidth="80" text="Check-in" />
                    <TableColumn fx:id="colBkStatus" prefWidth="100" text="Status" />
                </columns>
                <placeholder>
                    <Label styleClass="table-empty" text="Chưa có booking hôm nay" />
                </placeholder>
            </TableView>
        </VBox>

        <!-- RIGHT column -->
        <VBox minWidth="290" prefWidth="310" spacing="14">

            <!-- Room snapshot -->
            <VBox spacing="10" styleClass="content-panel">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Region styleClass="section-header-line" />
                    <Label styleClass="panel-title" text="Trạng Thái Phòng" />
                </HBox>
                <HBox spacing="8">
                    <VBox alignment="CENTER" spacing="4" styleClass="room-stat-box room-stat-occupied" HBox.hgrow="ALWAYS">
                        <Label fx:id="roomOccupied" styleClass="room-stat-num" text="—" />
                        <Label styleClass="room-stat-label" text="Đang dùng" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4" styleClass="room-stat-box room-stat-available" HBox.hgrow="ALWAYS">
                        <Label fx:id="roomAvailable" styleClass="room-stat-num" text="—" />
                        <Label styleClass="room-stat-label" text="Trống" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4" styleClass="room-stat-box room-stat-cleaning" HBox.hgrow="ALWAYS">
                        <Label fx:id="roomCleaning" styleClass="room-stat-num" text="—" />
                        <Label styleClass="room-stat-label" text="Đang dọn" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Grooming today -->
            <VBox spacing="10" styleClass="content-panel" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Region styleClass="section-header-line" />
                        <Label styleClass="panel-title" text="Grooming Hôm Nay" />
                    </HBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#onViewAllGrooming" styleClass="panel-link-btn" text="Xem →" />
                </HBox>
                <VBox fx:id="groomingList" spacing="8">
                    <!-- Populated by DashboardHomeController -->
                </VBox>
            </VBox>

        </VBox>
    </HBox>

    <!-- ── LOW STOCK ALERT ─────────────────────────────────── -->
    <VBox spacing="10" styleClass="content-panel alert-panel">
        <HBox alignment="CENTER_LEFT">
            <Label styleClass="panel-title panel-title-alert" text="⚠️  Cảnh Báo Tồn Kho Thấp" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#onViewInventory" styleClass="panel-link-btn" text="Đi đến kho →" />
        </HBox>
        <HBox fx:id="lowStockContainer" spacing="12">
            <!-- Populated by DashboardHomeController -->
        </HBox>
    </VBox>

</VBox>
