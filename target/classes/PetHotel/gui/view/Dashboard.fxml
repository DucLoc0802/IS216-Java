<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Dashboard.fxml
  Đặt tại: src/main/resources/PetHotel/gui/Dashboard.fxml
  CSS:      src/main/resources/PetHotel/css/style.css   (cùng file với Login)
  Controller: PetHotel.gui.controller.DashboardController
-->

<BorderPane prefHeight="800" prefWidth="1280" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PetHotel.gui.controller.DashboardController">

    <!-- ══════════════════════════════════════════════════════ -->
    <!--  SIDEBAR                                               -->
    <!-- ══════════════════════════════════════════════════════ -->
    <left>
        <VBox fx:id="sidebar" minWidth="240" prefWidth="240" styleClass="sidebar">

            <!-- Brand -->
            <VBox alignment="CENTER" spacing="4" styleClass="sidebar-brand">
                <Label styleClass="brand-icon" text="🐾" />
                <Label styleClass="brand-name" text="PET HOTEL" />
                <Label styleClass="brand-sub" text="Management System" />
            </VBox>

            <!-- User Profile -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-profile">
                <Label fx:id="avatarLabel" styleClass="avatar-circle" text="A" />
                <VBox spacing="2">
                    <Label fx:id="usernameLabel" styleClass="profile-name" text="Nguyễn Văn A" />
                    <Label fx:id="roleLabel" styleClass="profile-role" text="Admin Hệ Thống" />
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-divider" />

            <!-- Navigation Menu -->
            <ScrollPane fitToWidth="true" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="menuContainer" spacing="2" styleClass="menu-container">

                    <VBox fx:id="menuDashboard" onMouseClicked="#onMenuDashboard" styleClass="menu-item menu-item-active">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="menu-icon" text="⊞" />
                            <Label styleClass="menu-label" text="Dashboard" />
                        </HBox>
                    </VBox>

                    <VBox styleClass="menu-group">
                        <Label styleClass="menu-group-title" text="QUẢN LÝ NGHIỆP VỤ" />
                    </VBox>

                    <VBox fx:id="menuCustomer" onMouseClicked="#onMenuCustomer" styleClass="menu-item">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="menu-icon" text="👤" />
                            <Label styleClass="menu-label" text="Khách Hàng" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="menuPet" onMouseClicked="#onMenuPet" styleClass="menu-item">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="menu-icon" text="🐶" />
                            <Label styleClass="menu-label" text="Thú Cưng" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="menuBooking" onMouseClicked="#onMenuBooking" styleClass="menu-item">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="menu-icon" text="📅" />
                            <Label styleClass="menu-label" text="Booking" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="badgeBooking" styleClass="menu-badge menu-badge-warning" text="5" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="menuGrooming" onMouseClicked="#onMenuGrooming" styleClass="menu-item">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="menu-icon" text="✂️" />
                            <Label styleClass="menu-label" text="Grooming" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="menuRoom" onMouseClicked="#onMenuRoom" styleClass="menu-item">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="menu-icon" text="🏠" />
                            <Label styleClass="menu-label" text="Phòng" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="menuInvoice" onMouseClicked="#onMenuInvoice" styleClass="menu-item">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="menu-icon" text="🧾" />
                            <Label styleClass="menu-label" text="Hóa Đơn" />
                        </HBox>
                    </VBox>

                    <VBox styleClass="menu-group">
                        <Label styleClass="menu-group-title" text="KHO &amp; SẢN PHẨM" />
                    </VBox>

                    <VBox fx:id="menuProduct" onMouseClicked="#onMenuProduct" styleClass="menu-item">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="menu-icon" text="📦" />
                            <Label styleClass="menu-label" text="Sản Phẩm" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="menuInventory" onMouseClicked="#onMenuInventory" styleClass="menu-item">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="menu-icon" text="🏭" />
                            <Label styleClass="menu-label" text="Kho Hàng" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="badgeInventory" styleClass="menu-badge menu-badge-danger" text="!" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="menuSupplier" onMouseClicked="#onMenuSupplier" styleClass="menu-item">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="menu-icon" text="🏢" />
                            <Label styleClass="menu-label" text="Nhà Cung Cấp" />
                        </HBox>
                    </VBox>

                    <VBox styleClass="menu-group">
                        <Label styleClass="menu-group-title" text="QUẢN TRỊ HỆ THỐNG" />
                    </VBox>

                    <VBox fx:id="menuStaff" onMouseClicked="#onMenuStaff" styleClass="menu-item">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="menu-icon" text="👥" />
                            <Label styleClass="menu-label" text="Nhân Viên" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="menuAccount" onMouseClicked="#onMenuAccount" styleClass="menu-item">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="menu-icon" text="🔐" />
                            <Label styleClass="menu-label" text="Tài Khoản" />
                        </HBox>
                    </VBox>

                    <VBox fx:id="menuReport" onMouseClicked="#onMenuReport" styleClass="menu-item">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="menu-icon" text="📊" />
                            <Label styleClass="menu-label" text="Báo Cáo" />
                        </HBox>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- Footer -->
            <VBox styleClass="sidebar-footer">
                <Separator styleClass="sidebar-divider" />
                <HBox alignment="CENTER_LEFT" onMouseClicked="#onChangePassword" spacing="12" styleClass="menu-item">
                    <Label styleClass="menu-icon" text="🔑" />
                    <Label styleClass="menu-label" text="Đổi Mật Khẩu" />
                </HBox>
                <HBox alignment="CENTER_LEFT" onMouseClicked="#onLogout" spacing="12" styleClass="menu-item menu-item-logout">
                    <Label styleClass="menu-icon" text="🚪" />
                    <Label styleClass="menu-label" text="Đăng Xuất" />
                </HBox>
            </VBox>

        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════════════ -->
    <!--  CENTER                                                -->
    <!-- ══════════════════════════════════════════════════════ -->
    <center>
        <VBox styleClass="main-area">

            <!-- TOP BAR -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="topbar">
                <VBox spacing="2">
                    <Label fx:id="pageTitle" styleClass="page-title" text="Dashboard" />
                    <Label fx:id="pageBreadcrumb" styleClass="page-breadcrumb" text="Trang chủ" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-box">
                    <Label styleClass="search-icon" text="🔍" />
                    <TextField fx:id="globalSearch" promptText="Tìm kiếm nhanh..." styleClass="search-input" />
                </HBox>
                <StackPane styleClass="notif-wrapper">
                    <Button fx:id="btnNotification" onAction="#onNotification" styleClass="topbar-icon-btn" text="🔔" />
                    <Label fx:id="notifBadge" styleClass="notif-badge" text="3" />
                </StackPane>
                <HBox alignment="CENTER" spacing="6" styleClass="branch-selector">
                    <Label styleClass="branch-icon" text="📍" />
                    <Label fx:id="currentBranch" styleClass="branch-label" text="Chi Nhánh Q.1" />
                    <Label styleClass="branch-arrow" text="▾" />
                </HBox>
                <VBox alignment="CENTER_RIGHT" spacing="2" styleClass="datetime-box">
                    <Label fx:id="currentDate" styleClass="date-label" text="02/05/2026" />
                    <Label fx:id="currentTime" styleClass="time-label" text="08:30" />
                </VBox>
            </HBox>

            <!-- SCROLLABLE CONTENT -->
            <ScrollPane fx:id="contentScroll" fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="homeContent" spacing="24" styleClass="main-content">

                    <!-- STAT CARDS -->
                    <VBox spacing="12">
                        <Label styleClass="section-header" text="Tổng Quan Hôm Nay" />
                        <HBox spacing="16">

                            <VBox styleClass="stat-card stat-card-brown" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label styleClass="stat-icon" text="📅" />
                                    <VBox spacing="2">
                                        <Label styleClass="stat-label" text="Tổng Booking" />
                                        <Label fx:id="statBookingTotal" styleClass="stat-value" text="24" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <VBox alignment="CENTER_RIGHT">
                                        <Label styleClass="stat-delta stat-delta-up" text="+3 mới" />
                                        <Label styleClass="stat-delta-desc" text="so với hôm qua" />
                                    </VBox>
                                </HBox>
                                <Label styleClass="stat-sublabel" text="Booking hôm nay" />
                            </VBox>

                            <VBox styleClass="stat-card stat-card-green" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label styleClass="stat-icon" text="🏠" />
                                    <VBox spacing="2">
                                        <Label styleClass="stat-label" text="Phòng Đang Dùng" />
                                        <Label fx:id="statRoomOccupied" styleClass="stat-value" text="18/30" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <VBox alignment="CENTER_RIGHT">
                                        <Label styleClass="stat-delta" text="60%" />
                                        <Label styleClass="stat-delta-desc" text="công suất" />
                                    </VBox>
                                </HBox>
                                <Label styleClass="stat-sublabel" text="Phòng đang có thú cưng" />
                            </VBox>

                            <VBox styleClass="stat-card stat-card-amber" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label styleClass="stat-icon" text="💰" />
                                    <VBox spacing="2">
                                        <Label styleClass="stat-label" text="Doanh Thu Hôm Nay" />
                                        <Label fx:id="statRevenue" styleClass="stat-value" text="4.250.000đ" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <VBox alignment="CENTER_RIGHT">
                                        <Label styleClass="stat-delta stat-delta-up" text="+12%" />
                                        <Label styleClass="stat-delta-desc" text="so với hôm qua" />
                                    </VBox>
                                </HBox>
                                <Label styleClass="stat-sublabel" text="Tổng doanh thu ngày" />
                            </VBox>

                            <VBox styleClass="stat-card stat-card-red" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label styleClass="stat-icon" text="⚠️" />
                                    <VBox spacing="2">
                                        <Label styleClass="stat-label" text="Cảnh Báo Tồn Kho" />
                                        <Label fx:id="statLowStock" styleClass="stat-value" text="5 SP" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <VBox alignment="CENTER_RIGHT">
                                        <Label styleClass="stat-delta stat-delta-warn" text="Cần nhập" />
                                        <Label styleClass="stat-delta-desc" text="ngay hôm nay" />
                                    </VBox>
                                </HBox>
                                <Label styleClass="stat-sublabel" text="Sản phẩm tồn kho thấp" />
                            </VBox>

                            <VBox styleClass="stat-card stat-card-purple" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label styleClass="stat-icon" text="✂️" />
                                    <VBox spacing="2">
                                        <Label styleClass="stat-label" text="Grooming Chờ" />
                                        <Label fx:id="statGroomingPending" styleClass="stat-value" text="7" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <VBox alignment="CENTER_RIGHT">
                                        <Label styleClass="stat-delta" text="2 hôm nay" />
                                        <Label styleClass="stat-delta-desc" text="chờ xử lý" />
                                    </VBox>
                                </HBox>
                                <Label styleClass="stat-sublabel" text="Lịch grooming chưa hoàn thành" />
                            </VBox>

                        </HBox>
                    </VBox>

                    <!-- QUICK ACTIONS -->
                    <VBox spacing="12">
                        <Label styleClass="section-header" text="Quick Actions" />
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Button onAction="#onQuickCreateBooking" styleClass="action-btn action-btn-primary" text="+ Tạo Booking" />
                            <Button onAction="#onQuickCheckin" styleClass="action-btn action-btn-success" text="+ Check-in" />
                            <Button onAction="#onQuickCheckout" styleClass="action-btn action-btn-outline" text="Check-out" />
                            <Button onAction="#onQuickCreateInvoice" styleClass="action-btn action-btn-amber" text="+ Hóa Đơn" />
                            <Button onAction="#onQuickAddCustomer" styleClass="action-btn action-btn-outline" text="+ Khách Hàng" />
                            <Button onAction="#onQuickCheckRoom" styleClass="action-btn action-btn-outline" text="Kiểm Tra Phòng" />
                        </HBox>
                    </VBox>

                    <!-- TWO COLUMNS -->
                    <HBox spacing="20">
                        <VBox spacing="12" styleClass="content-panel" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label styleClass="panel-title" text="Booking Hôm Nay" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#onViewAllBooking" styleClass="panel-link-btn" text="Xem tất cả →" />
                            </HBox>
                            <TableView fx:id="todayBookingTable" styleClass="data-table">
                                <columns>
                                    <TableColumn fx:id="colBookingId" prefWidth="60" text="Mã" />
                                    <TableColumn fx:id="colPetName" prefWidth="110" text="Thú Cưng" />
                                    <TableColumn fx:id="colOwner" prefWidth="110" text="Chủ" />
                                    <TableColumn fx:id="colRoom" prefWidth="70" text="Phòng" />
                                    <TableColumn fx:id="colCheckIn" prefWidth="80" text="Check-in" />
                                    <TableColumn fx:id="colStatus" prefWidth="100" text="Status" />
                                </columns>
                                <placeholder>
                                    <Label styleClass="table-empty" text="Chưa có booking hôm nay" />
                                </placeholder>
                            </TableView>
                        </VBox>

                        <VBox minWidth="300" prefWidth="320" spacing="16">
                            <VBox spacing="12" styleClass="content-panel">
                                <Label styleClass="panel-title" text="Trạng Thái Phòng" />
                                <HBox spacing="8">
                                    <VBox alignment="CENTER" styleClass="room-stat-box room-stat-occupied" HBox.hgrow="ALWAYS">
                                        <Label fx:id="roomOccupied" styleClass="room-stat-num" text="18" />
                                        <Label styleClass="room-stat-label" text="Đang dùng" />
                                    </VBox>
                                    <VBox alignment="CENTER" styleClass="room-stat-box room-stat-available" HBox.hgrow="ALWAYS">
                                        <Label fx:id="roomAvailable" styleClass="room-stat-num" text="9" />
                                        <Label styleClass="room-stat-label" text="Trống" />
                                    </VBox>
                                    <VBox alignment="CENTER" styleClass="room-stat-box room-stat-cleaning" HBox.hgrow="ALWAYS">
                                        <Label fx:id="roomCleaning" styleClass="room-stat-num" text="3" />
                                        <Label styleClass="room-stat-label" text="Đang dọn" />
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox spacing="12" styleClass="content-panel" VBox.vgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="panel-title" text="Grooming Hôm Nay" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button onAction="#onViewAllGrooming" styleClass="panel-link-btn" text="Xem →" />
                                </HBox>
                                <VBox fx:id="groomingList" spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="grooming-item">
                                        <Label styleClass="grooming-time" text="09:00" />
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label styleClass="grooming-pet" text="Buddy - Golden" />
                                            <Label styleClass="grooming-service" text="Cắt tỉa toàn thân" />
                                        </VBox>
                                        <Label styleClass="status-badge status-pending" text="Chờ" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="grooming-item">
                                        <Label styleClass="grooming-time" text="10:30" />
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label styleClass="grooming-pet" text="Mimi - Poodle" />
                                            <Label styleClass="grooming-service" text="Tắm + vệ sinh" />
                                        </VBox>
                                        <Label styleClass="status-badge status-inprogress" text="Đang làm" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="grooming-item">
                                        <Label styleClass="grooming-time" text="14:00" />
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label styleClass="grooming-pet" text="Max - Corgi" />
                                            <Label styleClass="grooming-service" text="Spa cao cấp" />
                                        </VBox>
                                        <Label styleClass="status-badge status-done" text="Xong" />
                                    </HBox>
                                </VBox>
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- LOW STOCK -->
                    <VBox spacing="12" styleClass="content-panel alert-panel">
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="panel-title panel-title-alert" text="⚠️  Cảnh Báo Tồn Kho Thấp" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#onViewInventory" styleClass="panel-link-btn" text="Đi đến kho →" />
                        </HBox>
                        <HBox fx:id="lowStockContainer" spacing="12">
                            <VBox styleClass="stock-alert-item">
                                <Label styleClass="stock-name" text="Thức ăn hạt Premium" />
                                <Label styleClass="stock-qty stock-qty-critical" text="Còn: 3 túi  |  Min: 10" />
                            </VBox>
                            <VBox styleClass="stock-alert-item">
                                <Label styleClass="stock-name" text="Dầu gội thú cưng" />
                                <Label styleClass="stock-qty stock-qty-low" text="Còn: 5 chai  |  Min: 15" />
                            </VBox>
                            <VBox styleClass="stock-alert-item">
                                <Label styleClass="stock-name" text="Sữa tắm khử mùi" />
                                <Label styleClass="stock-qty stock-qty-critical" text="Còn: 2 chai  |  Min: 8" />
                            </VBox>
                        </HBox>
                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
   <stylesheets>
      <URL value="@../css/style.css" />
      <URL value="@../css/dashboard.css" />
   </stylesheets>

</BorderPane>
