<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="550" prefWidth="550" spacing="0" 
      styleClass="form-root"
      stylesheets="@../css/style.css" 
      xmlns="http://javafx.com/javafx/25" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="PetHotel.gui.controller.AddServiceController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
        <Label styleClass="form-header-icon" text="" />
        <VBox spacing="2">
            <Label styleClass="form-header-title"
                   text="Thêm Dịch Vụ Mới" />
            <Label styleClass="form-header-subtitle"
                   text="Tạo dịch vụ grooming mới cho cơ sở" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" 
                styleClass="form-close-btn"
                text="Đóng" />
    </HBox>

    <!-- BODY -->
    <VBox spacing="16" styleClass="form-body">

        <!-- SECTION: Thông Tin Cơ Bản -->
        <Label styleClass="form-section-title" text="Thông Tin Cơ Bản" />

        <VBox spacing="4">
            <Label styleClass="form-label" text="Tên Dịch Vụ *" />
            <TextField fx:id="txtServiceName" 
                      promptText="VD: Tắm chó, Cắt lông mèo..." 
                      styleClass="form-field" />
            <Label fx:id="lblServiceNameError" styleClass="form-error" text="" />
        </VBox>

        <Separator styleClass="form-divider" />

        <!-- SECTION: Phân Loại -->
        <Label styleClass="form-section-title" text="Phân Loại" />

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Loại Dịch Vụ *" />
                <ComboBox fx:id="cmbCategory" styleClass="form-combo" />
                <Label fx:id="lblCategoryError" styleClass="form-error" text="" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Loài Thú Cưng" />
                <TextField fx:id="txtSpecies" 
                          promptText="VD: Chó, Mèo, Chim..." 
                          styleClass="form-field" />
                <Label fx:id="lblSpeciesError" styleClass="form-error" text="" />
            </VBox>
        </HBox>

        <Separator styleClass="form-divider" />

        <!-- SECTION: Giá & Thời Gian -->
        <Label styleClass="form-section-title" text="Giá &amp; Thời Lượng" />

        <HBox spacing="14">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Giá Cơ Bản (VNĐ) *" />
                <TextField fx:id="txtPrice" 
                          promptText="VD: 150000" 
                          styleClass="form-field" />
                <Label fx:id="lblPriceError" styleClass="form-error" text="" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Thời Gian (Phút) *" />
                <TextField fx:id="txtDuration" 
                          promptText="VD: 60" 
                          styleClass="form-field" />
                <Label fx:id="lblDurationError" styleClass="form-error" text="" />
            </VBox>
        </HBox>

        <Label styleClass="form-hint" 
               text="Thông tin được đánh dấu (*) là bắt buộc" />

    </VBox>

    <!-- FOOTER -->
    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="form-footer">
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" 
                styleClass="btn-secondary" 
                text="Hủy" />
        <Button onAction="#handleSave" 
                styleClass="btn-primary" 
                text="Thêm Dịch Vụ" />
    </HBox>

</VBox>
