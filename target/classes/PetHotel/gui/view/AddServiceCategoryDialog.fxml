<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="550" prefWidth="550" spacing="0" 
      styleClass="form-root"
      stylesheets="@../css/style.css" 
      xmlns="http://javafx.com/javafx/25" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="PetHotel.gui.controller.AddServiceCategoryController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
        <Label styleClass="form-header-icon" text="" />
        <VBox spacing="2">
            <Label styleClass="form-header-title"
                   text="Thêm Loại Dịch Vụ Mới" />
            <Label styleClass="form-header-subtitle"
                   text="Tạo loại dịch vụ grooming mới" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" 
                styleClass="form-close-btn"
                text="Đóng" />
    </HBox>

    <!-- BODY -->
    <VBox spacing="16" styleClass="form-body">

        <!-- SECTION: Tên Loại Dịch Vụ -->
        <Label styleClass="form-section-title" text="Thông Tin Cơ Bản" />

        <VBox spacing="4">
            <Label styleClass="form-label" text="Tên Loại Dịch Vụ *" />
            <TextField fx:id="txtCategoryName" 
                      promptText="Nhập tên loại dịch vụ (vd: Tắm chó, Cắt lông...)" 
                      styleClass="form-field" />
            <Label fx:id="lblCategoryNameError" styleClass="form-error" text="" />
        </VBox>

        <Separator styleClass="form-divider" />

        <!-- SECTION: Ghi Chú -->
        <Label styleClass="form-section-title" text="Ghi Chú &amp; Mô Tả" />

        <VBox spacing="4">
            <Label styleClass="form-label" text="Ghi Chú (Tùy Chọn)" />
            <TextArea fx:id="txtNote" 
                     promptText="Nhập ghi chú/mô tả về loại dịch vụ này..." 
                     styleClass="form-area"
                     prefRowCount="4"
                     wrapText="true" />
            <Label fx:id="lblNoteError" styleClass="form-error" text="" />
        </VBox>

        <Label styleClass="form-hint" 
               text="Thông tin được đánh dấu (*) là bắt buộc" />

    </VBox>

    <!-- FOOTER -->
    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="form-footer">
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" 
                styleClass="btn-secondary" 
                text="Hủy" />
        <Button onAction="#handleSave" 
                styleClass="btn-primary" 
                text="Thêm Loại Dịch Vụ" />
    </HBox>

</VBox>
